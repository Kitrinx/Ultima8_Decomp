				local_m06 = <<"His father? ", "Great things? ", "Simple folk. ">>;
			}
			case "His father? "
			{
				bark("That would be my husband, Gwillim. ");
				local_m06 -= <<"His father? ">>;
			}
			case "Simple folk. "
			{
				bark("Look about you, my lord. Does this look like the home of a wealthy family? Ours are not easy lives, yet we are proud people. Not many can do what we do. And our family has lived in this valley and worked the land for generations. ");
				local_m06 += <<"What do you do? ", "You've been here for generations? ">>;
				local_m06 -= <<"Simple folk. ">>;
			}
			case "You've been here for generations? "
			{
				bark("Oh yes. There used to be a great many families that lived in the valley. But that was long ago. Now, only Gwillim and I are left to keep the legacy of the valley alive. ");
				local_m06 = <<"Legacy? ", "What happened to the others? ">>;
				local_m06 -= <<"You've been here for generations? ">>;
			}
			case "Legacy? "
			{
				bark("Yes, we are the only folk that are left who know the myths and legends of the valley. It is sad, but we are the only people left who care of such things. ");
				local_m06 += <<"No one cares? ">>;
				local_m06 -= <<"Legacy? ">>;
			}
			case "No one cares? "
			{
				bark("There is no one -left- to care. Roam this valley all that you wish and the only people that you will see are Gwillim and myself. ");
				local_m06 -= <<"No one cares? ">>;
			}
			case "What happened to the others? "
			{
				bark("Well, there was a great war long, long ago. That was the beginning of the end, I suppose. Since that time, many people believed that the land was cursed. Many people died and many others moved away. ");
				if darionGhostStory or jennaGhostStory
				{
					local_m06 ^= <<"Cursed? By a ghost, perhaps? ">>;
				}
				else
				{
					local_m06 += <<"Cursed? ">>;
				}
				local_m06 += <<"Where did the people move? ">>;
				local_m06 -= <<"What happened to the others? ">>;
			}
			case "Cursed? "
			{
				bark("Well that is what some folk believe, but Gwillim and I... That is to say, ahh... Some people believe that the land is cursed. It is best left at that. ");
				local_m06 -= <<"Cursed? ">>;
			}
			case "Where did the people move? "
			{
				bark("My father says that most of them moved to the city. ");
				local_m06 += <<"This was before your time? ", "The city? You're kidding! ">>;
				local_m06 -= <<"Where did the people move? ">>;
			}
			case "The city? You're kidding! "
			{
				bark("No, I am quite serious. The city, like the valley has suffered much and many people have died. ");
				local_m06 -= <<"The city? You're kidding! ">>;
			}
			case "This was before your time? "
			{
				bark("Oh yes, it was long ago. I have only heard stories. By the time I was born, there were only two families here in the valley, mine and Gwillim's. ");
				local_m06 += <<"What about when you go? ", "And Gwillim's family? ">>;
				local_m06 -= <<"This was before your time? ">>;
			}
			case "And Gwillim's family? "
			{
				bark("Oh, they too died off. Gwillim's only brother died rather tragically, and his parents eventually died of age. ");
				if corinthToldGhost
				{
					local_m06 += <<"How did he die? ">>;
				}
				local_m06 -= <<"And Gwillim's family? ">>;
			}
			case "Cursed? By a ghost, perhaps? "
			{
				bark("Yes! How did you know that? ");
				corinthToldGhost = 1;
				local_m06 = <<"I have heard tales. ", "Can you tell me of the ghost? ">>;
			}
			case "What about when you go? "
			{
				bark("It is sad, but I fear that when Gwillim and I are gone, then gone too shall be this way of life. I blame myself for it. ");
				local_m06 += <<"That is sad, indeed. ", "You blame -yourself-? ">>;
				local_m06 -= <<"What about when you go? ">>;
			}
			case "That is sad, indeed. "
			{
				bark("I suppose that is the way of things. But still, I can not help but cry when I think of it. ");
				local_m06 -= <<"That is sad, indeed. ">>;
			}
			case "You blame -yourself-? "
			{
				bark("Oh, please forget that ever I said such a thing. I need not trouble someone who is a virtual stranger with talk such as this. I have rattled on for far too long as it is. ");
				local_m06 += <<"This is no trouble. ", "How could you blame yourself? ">>;
				local_m06 -= <<"You blame -yourself-? ">>;
			}
			case "This is no trouble. "
			{
				bark("I thank you. You are kind to say so. ");
				local_m06 -= <<"This is no trouble. ">>;
			}
			case "How could you blame yourself? "
			{
				bark("Well, there was an accident many years ago... You see, Cyrrus was not our only child. Oh dear, I can not believe that I am telling you all of this. ");
				local_m06 += <<"It's ok, go on. ", "Stop if you wish. ">>;
				local_m06 -= <<"How could you blame yourself? ">>;
			}
			case "Stop if you wish. "
			{
				bark("No, I will continue. For some reason it feels good to tell this to someone. I had a child after Cyrrus, a baby girl. One day while the baby was still very young, I went into the barn to fetch a pail. I was only gone but for a moment, but while I was out of the house, a kith did come into the house and devour my baby. ");
				local_m06 += <<"How tragic! ">>;
				local_m06 -= <<"Stop if you wish. ">>;
			}
			case "It's ok, go on. "
			{
				bark("Yes, I shall. You see, when Cyrrus was still young, I gave birth to a baby girl. One day while the baby was still very young, I went into the barn to fetch a pale. I was only gone but for a moment, but while I was out of the house, a kith did come into the house and devour my baby. ");
				local_m06 += <<"How tragic! ">>;
				local_m06 -= <<"It's ok, go on. ">>;
			}
			case "How tragic! "
			{
				bark("For years I have carried the shame and guilt of knowing that I was responsible for my baby's death. Gwillim has always been very kind and supportive. He tried to tell me that it was not my fault, yet always will have to live with this sadness. ");
				local_m06 -= <<"How tragic! ">>;
			}
			case "I have heard tales. "
			{
				bark("Strange. I had no idea that such tales have stretched very far. ");
				local_m06 -= <<"I have heard tales. ">>;
			}
			case "Can you tell me of the ghost? "
			{
				bark("Well, I have not seen the ghost myself. I have only heard stories. However, Gwillim, my husband, has seen the creature, but he is very reluctant to talk about it. ");
				local_m06 += <<"Gwillim's seen the ghost? ", "Why is he reluctant to talk? ">>;
				local_m06 -= <<"Can you tell me of the ghost? ">>;
			}
			case "Gwillim's seen the ghost? "
			{
				bark("Yes, twice, and it was long ago. The first time was when he and his brother were young men. They where watching over their herd when upon the hillside they saw a glowing form above them. ");
				local_m06 += <<"What about the second time? ", "They both saw it? ">>;
				local_m06 -= <<"Gwillim's seen the ghost? ">>;
			}
			case "What about the second time? "
			{
				bark("The second time, the ghost was actually on the ground, in front of Gwillim. He said that the ghost appeared to dance around him, as though it was mocking Gwillim. He also said that it looked most unusual for a ghost. ");
				local_m06 += <<"Where was it the second time? ", "It looked unusual? ">>;
				local_m06 -= <<"What about the second time? ">>;
			}
			case "They both saw it? "
			{
				bark("Indeed they did. From that time on, Karpese, that was Gwillim's brother was obsessed with capturing the ghost. ");
				local_m06 -= <<"They both saw it? ">>;
			}
			case "Why is he reluctant to talk? "
			{
				bark("Gwillim was frightened very deeply by what he saw. He is a strong man and does not scare easily. Whatever Gwillim saw did disturb him deeply and brings back memories of his brother. Therefore Gwillim does not like to speak of the ghost. ");
				local_m06 -= <<"Why is he reluctant to talk? ">>;
			}
			case "It looked unusual? "
			{
				bark("Yes. Anyone who has had the misfortune to have visited the graveyard has probably seen a ghost floating in the distance. It is not unusual to see something such as that in a place where there is nothing but death. But Gwillim told me that the ghost that haunts this valley is different. ");
				local_m06 += <<"How is it different? ">>;
				local_m06 -= <<"It looked unusual? ">>;
			}
			case "How is it different? "
			{
				bark("Well, most ghosts that people have seen are vaporous in appearance. According to Gwillim, this ghost here is invisible except for the armor which it bears. It is most unusual. ");
				local_m06 -= <<"How is it different? ">>;
			}
			case "Where was it the second time? "
			{
				bark("I am not certain. Gwillim could tell you if you can get him to speak of the ghost. ");
				local_m06 -= <<"Where was it the second time? ">>;
			}
			case "How did he die? "
			{
				bark("He went searching for the ghost and did never return. ");
				local_m06 -= <<"How did he die? ">>;
			}
			case "Torax? "
			{
				bark("Yes, the animals that you will see grazing here in the valley. Do not tell me that you have never heard of a torax. We have been trying to increase the size of our herd so that we can save a little bit more money. ");
				local_m06 += <<"Save money? ">>;
				local_m06 -= <<"Torax? ">>;
			}
			case "Save money? "
			{
				bark("Yes, it is difficult to do because we don't have very much. Sometimes my husband hunts kiths to bring in extra food. ");
				local_m06 += <<"He hunts kiths? ">>;
				local_m06 -= <<"Save money? ">>;
			}
			case "He hunts kiths? "
			{
				bark("Kith meat is very tasty but they are dangerous animals. It is said that a kith can cut a man in half with its jaws. ");
				local_m06 -= <<"He hunts kiths? ">>;
				local_m06 += <<"That sounds dangerous. ">>;
			}
			case "That sounds dangerous. "
			{
				bark("Not many people hunt them. But Gwillim is very good at it. ");
				local_m06 -= <<"That sounds dangerous. ">>;
			}
			case "Your husband? "
			{
				bark("Gwillim is my husband. He is a strong and goodly man. ");
				local_m06 += <<"Strong and goodly? ">>;
				local_m06 -= <<"Your husband? ">>;
			}
			case "Strong and goodly? "
			{
				bark("Many men drink every night and beat their wives but Gwillim does not do such things. He does not even mind that I sacrifice to Hydros. ");
				local_m06 += <<"You sacrifice to Hydros? ">>;
				local_m06 -= <<"Strong and goodly? ">>;
			}
			case "You sacrifice to Hydros? "
			{
				bark("Gwillim is a farmer, so he sacrifices to Lithos, the Earth Titan. But, like my father, I sacrifice to the Water Titan, Hydros. ");
				local_m06 -= <<"You sacrifice to Hydros? ">>;
				local_m06 += <<"Why Hydros? ">>;
			}
			case "Why Hydros? "
			{
				bark("My father taught me to sacrifice to Hydros. All of my family has sacrificed to the Lurker for as far back as any can remember. ");
				local_m06 -= <<"Why Hydros? ">>;
			}
			case "Great things? "
			{
				bark("Yes! Cyrrus has gone to study with the Theurgists. He will help many people as a Theurgist. ");
				local_m06 = <<"Theurgist ", "Help people? ">>;
			}
			case "Theurgist "
			{
				bark("The Theurgists are the disciples of the Air Titan. Although Gwillim sacrifices to Lithos, I believe that Cyrrus was born to be a Theurgist. ");
				local_m06 += <<"But what of Hydros? ", "Born to be a Theurgist? ">>;
				local_m06 -= <<"Theurgist ">>;
			}
			case "Help people? "
			{
				bark("The Theurgists specialize in healing the sick. Some say that they can even bring back the dead. ");
				local_m06 -= <<"Help people? ">>;
			}
			case "But what of Hydros? "
			{
				bark("All of the Titans are worthy of service. Gwillim did not much like the idea of Cyrrus being a Theurgist but saw the boy's dedication. If Cyrrus is meant to serve Stratos then we must not stand in his way. ");
				local_m06 -= <<"But what of Hydros? ">>;
				local_m06 += <<"All of the Titans are worthy? ">>;
			}
			case "All of the Titans are worthy? "
			{
				bark("By that, I mean that all of the Titans are great powers. I do not mean to say that all are not worthy of good people's service. I would not claim that Pyros and his sorcerers are worthy of such. ");
				local_m06 -= <<"All of the Titans are worthy? ">>;
				local_m06 += <<"Sorcerers? ">>;
			}
			case "Born to be a Theurgist? "
			{
				bark("All of his life Cyrrus has most enjoyed caring for others. He has always a talent for healing. It did not matter if it was a person or an animal, Cyrrus would heal it if it were sick. I knew that he was born to be a Theurgist, not to spend his life on a farm. ");
				local_m06 += <<"Even animals? ", "Not at the farm ">>;
				local_m06 -= <<"Born to be a Theurgist? ">>;
			}
			case "Sorcerers? "
			{
				bark("Ask me nothing of them. It is ill business to speak of the sorcerers. ");
				local_m06 -= <<"Sorcerers? ">>;
			}
			case "Not at the farm "
			{
				bark("Gwillim wanted very much for Cyrrus to follow in his footsteps at the farm. I convinced Cyrrus that his future was more important than his father's traditions. ");
				local_m06 += <<"His future? ", "His father's tradition. ">>;
				local_m06 -= <<"Not at the farm ">>;
			}
			case "His father's tradition. "
			{
				bark("All of Gwillim's kin have always been herdsmen. Gwillim takes great pride in working the land. As Cyrrus is our only son, Gwillim expected Cyrrus to carry on the family's traditions. ");
				local_m06 -= <<"His father's tradition. ">>;
			}
			case "So, you don't see many strangers? "
			{
				bark("We rarely have visitors here in the country.\x09We do see that strange old hermit once in a while, though. ");
				local_m06 += <<"What hermit? ">>;
				local_m06 -= <<"So, you don't see many strangers? ">>;
			}
			case "What hermit? "
			{
				bark("I believe that his name is Mythran. He goes into Tenebrae now and then, for supplies I suppose. No one knows much about Mythran but there are many tales about him. ");
				local_m06 += <<"What kinds of tales? ">>;
				local_m06 -= <<"What hermit? ">>;
			}
			case "What kinds of tales? "
			{
				bark("Oh I don't not know them all. People claim that he knows magic. Some people even claim to have bought magic scrolls from the old hermit. But I would not believe everything that you hear. ");
				local_m06 -= <<"What kinds of tales? ">>;
				mythranScrolls = 1;
			}
			case "His future? "
			{
				bark("I knew that if Cyrrus became a farmer, he would be poor for the rest of life. Gwillim does not know that I convinced Cyrrus to seek the Theurgists, but I had to, for Cyrrus' sake. Now he can lead a life far richer than that of a farm man. ");
				local_m06 -= <<"His future? ">>;
			}
			case "Even animals? "
			{
				bark("My, but you do ask many questions! But yes, Cyrrus loves animals. He has always been a caring man. ");
				local_m06 -= <<"Even animals? ">>;
				local_m06 += <<"I'm sorry if I ask too many questions. ">>;
			}
			case "I'm sorry if I ask too many questions. "
			{
				bark("No, I am sorry if I made you uncomfortable. I enjoy your company! As I said, we do not see many visitors here, I am glad to have someone to talk to. ");
				local_m06 -= <<"I'm sorry if I ask too many questions. ">>;
			}
			case "Goodbye. "
			{
				bark("Farewell ");
				local_m06 -= <<"Goodbye. ">>;
				exitConvo();
				return;
			}
		}
	}
}

