					bark("Oh my, we aren't too up on titles are we? Yes, I am the seneschal. It is my duty to take care of running the day to day affairs of the city so that our Tempest, the Lady Mordea, can concentrate on more important things. ");
					askList = <<"What is a Tempest? ", "Tell me about Lady Mordea. ", "What more important things? ">>;
				}
