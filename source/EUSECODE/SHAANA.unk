					local_m0C += <<"Why was Bentic killed? ">>;
				}
				shaanaMad = 1 + shaanaMad;
				local_m08 = 0;
			}
			case "What is your task? "
			{
				bark("I think that you need not know such things. But let me assure you that not all of my life revolves around death. Most times there are far more interesting things to study than a decapitated body. ");
				local_m0C = <<"Only most of the time? ", "What do you study? ", "Goodbye. ">>;
			}
			case "Only most of the time? ", "Yet you study other pursuits. "
			{
				local_m07 = 1;
				bark("I have warned you not to pry into my affairs. Do not fool yourself into thinking that I am incapable of performing the duties of my position -- even when the victims are not bound. I have -no- qualms about slaying someone who deserves to die. ");
				turnToFace((getDir() + 2) modulo 8, 0, 15);
				bark("Though I do not necessarily agree with the Lady's methods. ");
				local_m0C -= <<"Only most of the time? ", "Yet you study other pursuits. ">>;
				local_m0C += <<"With what do you disagree? ">>;
			}
			case "With what do you disagree? "
			{
				if devonInRule
				{
					bark("'Tis a moot point, considering she is no longer alive, but it was not right to let the body fall to The Lurker. It violated the pact, something which Lithos was not likely to tolerate much longer. ");
				}
				else
				{
					bark("'Tis not right to let the body fall to The Lurker. It violates the pact, something for which Lithos will not likely stand much longer. ");
				}
				local_m0C -= <<"With what do you disagree? ">>;
				if not lithosHis
				{
					local_m0C += <<"Who is Lithos? ", "What pact? ">>;
				}
			}
			case "Who is Lithos? "
			{
				bark("I know not from where you hail, stranger, but I wonder about a man who does not know of the Titans. Speak to the scholar.  He will show you the answer to your question. I assume you -do- know how to read. ");
				lithosHis = 1;
				local_m0C -= <<"Who is Lithos? ">>;
			}
			case "What pact? "
			{
				bark("You know very little of our culture, stranger. I suggest that change. The pact is one forged ages ago between Lithos and our people.\x09Our duty from the covenant is to send our dead to Lithos. Yet Lady Mordea elects to give them to her patron, Hydros. 'Tis only a matter of time before the dead rise up and avenge the Mountain King. ");
				lithosHis = 1;
				local_m0C -= <<"What pact? ">>;
				local_m0C += <<"Dead rising up? ", "The Mountain King? ">>;
			}
			case "The Mountain King? "
			{
				bark("'Tis the earned title for Lithos, He who resides in the great Hall within the mountains. However, few have ever been there. ");
				local_m0C -= <<"The Mountain King? ", "Dead rising up? ">>;
				local_m0C += <<"Which few? ">>;
			}
			case "Dead rising up? "
			{
				bark("Aye, so the story goes. When he is angry, Lithos will set upon us our long lost kindred which he has willed to live again. Well, 'tis hardly living, but legend holds that they walk and fight like men. I have seen such wander about inside the confines of the cemetery, though even -I- have not dared to enter within. ");
				local_m0C += <<"Why do you avoid the cemetery? ">>;
				local_m0C -= <<"Dead rising up? ", "The Mountain King? ">>;
			}
			case "Which few? "
			{
				bark("The Necromancers. ");
				local_m0C -= <<"Which few? ">>;
				local_m0C += <<"Who are the Necromancers? ">>;
			}
			case "Who are the Necromancers? "
			{
				bark("I tire of these questions. They are common to all Tenebraeans, yet to me do you pose them. The Necromancers are the line of mages who carry out our half of the pact with Lithos. Their duties are quite distasteful, but they are necessary. If you are truly interested in them, why not speak to them yourself. ");
				local_m0C -= <<"Who are the Necromancers? ">>;
				local_m0C += <<"Are they in the cemetery? ">>;
			}
			case "Are they in the cemetery? "
			{
				bark("Do not tell me you are so much a fool as to take me seriously! I will grant you this, stranger, you are indeed brave if not equally senseless! Aye, the Necromancers reside in the graveyard. Beware where you tread. ");
				local_m0C -= <<"Are they in the cemetery? ">>;
			}
			case "Why do you avoid the cemetery? "
			{
				bark("An odd question, stranger. I do not wish audience with the dead. That is the realm of the Necromancers. ");
				local_m0C -= <<"Why do you avoid the cemetery? ">>;
				local_m0C += <<"Who are the Necromancers? ">>;
			}
			case "What do you study? "
			{
				if local_m07
				{
					bark("My dear stranger, if I have not yet made it perfectly clear that my business is none of your concern, let me do so now. My business, -is- none of your concern. ");
					exitConvo();
					return;
				}
				else
				{
					bark("My dear stranger, if I have not yet made it perfectly clear that my business is none of your concern, let me do so now. As far as you need know, I am but an executioner. Nothing more, but nothing less. ");
					local_m0C = <<"Yet you study other pursuits. ", "Goodbye. ">>;
				}
			}
			case "Why was Bentic killed? "
			{
				bark("'Tis not mine to judge the condemned. I simply carry out The Lady's commands. If you have issue with that, I suggest you speak with her. Goodbye. ");
				exitConvo();
				return;
			}
			case "Why are you here? "
			{
				bark("'Twould be best for you, stranger, to ignore such things.\x09Tell no one of seeing me here... or you, yourself, shall feel my axe upon your scrawny neck. ");
				sawShaana = 1;
				exitConvo();
				return;
			}
			case "Goodbye. ", "No, sorry. Goodbye. "
			{
				local_m0C -= <<"Goodbye. ", "No, sorry. Goodbye. ">>;
				exitConvo();
				return;
			}
		}
	}
}

