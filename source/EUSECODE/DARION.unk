	u8label label_3230:
	// X: reconstructed repeated-string selection; authored switch versus if ladder is unproved.
	switch answer
	{
		case "Tell me about the palace. "
		{
			if devonInRule
			{
				bark("The palace is the home of our Tempest, Devon. ");
			}
			else
			{
				bark("The palace is the home of our Tempest, the Lady Mordea. ");
			}
			askList -= <<"Tell me about the palace. ", "bye ">>;
			askList += <<"Who is Lady Mordea? ", "bye ">>;
		}
		case "Tell me about Tenebrae. "
		{
			if hasAvaName
			{
				bark("Ah, Tenebrae, 'tis the finest gem in this fair land. I have served this city and her leaders since I was a mere lad, as an apprentice in the guard. I welcome you, " + getName() + ", to our fair city.");
			}
			else
			{
				bark("Ah, Tenebrae, 'tis the finest gem in this fair land. I have served this city and her leaders since I was a mere lad, as an apprentice in the guard. I welcome you to our fair city. ");
			}
			askList -= <<"Tell me about Tenebrae. ", "bye ">>;
			askList += <<"bye ">>;
		}
		case "Who is Lady Mordea? "
		{
			bark("The fair Tempest of our City. ");
			askList -= <<"Who is Lady Mordea? ", "bye ">>;
			askList += <<"bye ">>;
		}
		case "Who are the Palace Guards? "
		{
			bark("The finest fighting regiment in the land. But there is not much call for defense anymore. We mostly spend our time in preserving the peace. That's not to say we wouldn't be ready if needed, though. ");
			askList -= <<"Who are the Palace Guards? ">>;
			askList = <<"Ready for what? ", "bye ">>;
		}
		case "Ready for what? "
		{
			bark("Of course, you never know what those Necromancers are up to. And we do have our fine Tempest to defend. ");
			askList -= <<"Ready for what? ">>;
			askList = <<"Who is the Tempest? ", "Who are the Necromancers? ", "You defend her? ", "bye ">>;
		}
		case "You defend her? "
		{
			bark("Of course, our Tempest is more than capable of defending herself. She has a portion of Hydros' power. ");
			askList -= <<"You defend her? ", "bye ">>;
			askList += <<"bye ">>;
		}
		case "Who is the Tempest? "
		{
			bark("Why, she is the representative of that mightiest of Titans, Hydros. Hydros' visage is much too fearsome and powerful for the likes of you and I, so Lady Mordea serves as her representative. In exchange, Lady Mordea is able to wield some of the power from Hydros. ");
			askList -= <<"Who is the Tempest? ">>;
			askList = <<"What power? ", "Who is Hydros? ", "bye ">>;
		}
		case "What power? "
		{
			bark("Why do you think we have fair weather all the day? With her share of Hydros' power, Lady Mordea is able to control the weather. 'Tis a blessing, it is. ");
			askList -= <<"What power? ", "bye ">>;
			askList += <<"bye ">>;
		}
		case "Who is Hydros? "
		{
			bark("Keep a respectful tongue in your head when you speak that name, my friend. The Lurker is a force to be reckoned with. She is the power of all the waters. She can be as gentle as a spring rain or as powerful and terrible as a thundering waterfall. She is the mightiest of all the Titans. Well worth your respect and worship. ");
			askList -= <<"Who is Hydros? ", "bye ">>;
			askList += <<"bye ">>;
		}
		case "Who are the Necromancers? "
		{
			bark("Filthy things, they live in the cemetery and muck about with dead bodies. They serve the Titan Lithos. 'Tis no wonder there are so few Necromancers left. Only those who grub for a paltry living from the mud and dirt have anything to do with Lithos and the Necromancers. Phaw! ");
			askList -= <<"Who are the Necromancers? ", "bye ">>;
			askList ^= <<"Tell me about the cemetery. ", "Only a few Necromancers? ", "bye ">>;
		}
		case "Only a few Necromancers? "
		{
			bark("I do not know exactly how many there are, but even one is one too many for my liking. ");
			askList -= <<"Only a few Necromancers? ", "bye ">>;
			askList += <<"bye ">>;
		}
		case "Tell me about the cemetery. "
		{
			bark("That's where those filthy creatures keep their home. They like to be as near the dead as they can. If you ask me, I think they wait until late in the night and then dig up the bodies so they can do all manner of grotesque things to them. It churns my belly to think of it. ");
			askList -= <<"Tell me about the cemetery. ", "bye ">>;
			askList += <<"bye ">>;
		}
		case "An emergency situation? "
		{
			bark("By Hydros' spume, man! Can't you see? The dead are walking the streets! I have a town to protect! A Tempest to find! People to calm! I haven't time for gawkers! ");
			exitConvo();
			return;
		}
		case "What do you know about Salkind? "
		{
			bark("Hmmmmm, I don't know much about him, except he is always at the side of Lady Mordea. I'm not sure I trust him. ");
			askList -= <<"What do you know about Salkind? ", "bye ">>;
			askList += <<"Why don't you trust Salkind? ", "bye ">>;
		}
		case "Why don't you trust Salkind? "
		{
			bark("Well, the Tempest has always ruled alone. This seneschal bit seems to go against our fine line of tradition here in Tenebrae. I'm not sure I agree, but then, Lady Mordea seems to like him, so I'll protect him as well as her. ");
			askList -= <<"Why don't you trust Salkind? ">>;
		}
		case "I met your daughter, Jenna. "
		{
			bark("Ah, she is a beauty, isn't she? She is my pride and joy, you know. Why, she is the exact picture of her dear, departed mother. ");
			askList -= <<"I met your daughter, Jenna. ">>;
			askList = <<"What happened to her mother? ", "She is beautiful. ", "bye ">>;
		}
		case "What happened to her mother? "
		{
			bark("That is a sad tale. She was the love of my life. A beauty with long blonde hair and eyes as green as the Sea of Rains. She took with the fever shortly after dear Jenna was born. I did everything I could, but it was no use. She died in my arms and with her last breath whispered, 'I love you'. ");
			askList -= <<"What happened to her mother? ", "bye ">>;
			askList += <<"That is a tragic tale. ", "bye ">>;
		}
		case "That is a tragic tale. "
		{
			bark("I can only honor her with my memories, for there is no physical marker for her, no grave. ");
			askList -= <<"That is a tragic tale. ", "bye ">>;
			askList += <<"Why is there no grave? ", "bye ">>;
		}
		case "Why is there no grave? "
		{
			bark("There was a grave, there WAS one. But one day as I went to leave flowers on her stone, as was my want, I found the grave ripped open and the body missing. It could only be the work of those filthy Necromancers. It pains me still to think of it. ");
			askList -= <<"Why is there no grave? ">>;
		}
		case "She is beautiful. "
		{
			bark("That she is. Every man in town has asked for her hand, but I'm afraid there is too much of her father in her. I do wish she could find the right one, though. But it will take someone with a strength of character and a soundness of mind that you just don't find around here. Perhaps it will take someone... someone much like yourself, hmmmm? ");
			askList -= <<"She is beautiful. ">>;
			askList = <<"Bye ">>;
		}
		case "Bye "
		{
			spokeAboutJenna = 1;
			ran = random(5);
			if ran = 0
			{
				bark("Did I tell you that she can wield a sword as well as any man? Taught her myself. Right dangerous she is with that thing. ");
				askList = <<"Bye ">>;
			}
			if ran = 1
			{
				bark("Did I mention she can cook? She makes a fine pie, Yessir, makes my mouth water just thinking about it. ");
				askList = <<"Bye ">>;
			}
			if ran = 2
			{
				bark("She keeps an immaculate house, she does. Why you could eat right off the floor. ");
				askList = <<"Bye ">>;
			}
			if ran = 3
			{
				bark("She's a beauty, all right. A man would be right proud to have her by his side. ");
				askList = <<"Bye ">>;
			}
			if ran = 4
			{
				bark("Oh, and did I mention how much she loves children? Wants a house full of them, she does. ");
				askList = <<"GOODBYE! ">>;
			}
		}
		case "I regret to tell you no. "
		{
			bark("You're sure then? Did I mention that she is educated and can discuss many matters of interest quite well? ");
			askList = <<"Bye ">>;
		}
		case "Yes, I want to marry your daughter! "
		{
			bark("Oh that's wonderful! But, ummm...there is one little detail I forgot to mention, Oh but it's a little thing, it can wait till after the ceremony. Now, how soon do you want the ceremony? ");
			askList -= <<"Yes, I want to marry your daughter! ">>;
			askList = <<"What little detail? ", "What ceremony? ", "Bye ">>;
		}
		case "What little detail? "
		{
			bark("Just a little something. Ummmm, well, it's really nothing. Ummm, has she mentioned whether or not she likes you, at all? ");
			askList -= <<"What little detail? ", "Bye ">>;
			askList += <<"She is angry with me. ", "Oh, she likes me. ", "Bye ">>;
		}
		case "Oh, she likes me. "
		{
			bark("Oh that is wonderful. Perhaps that will avoid the problem then. ");
			askList -= <<"Oh, she likes me. ", "She is angry with me. ", "Bye ">>;
			askList ^= <<"What problem? ">>;
			askList += <<"Bye ">>;
		}
		case "She is angry with me. "
		{
			bark("Oh, that could be a problem. ");
			askList -= <<"She is angry with me. ", "Oh, she likes me. ", "Bye ">>;
			askList += <<"What problem? ", "Bye ">>;
		}
		case "What problem? "
		{
			bark("Well, it's just that she, ahhh, has...well it's a little embarrassing, it seems she has sworn to kill any man chosen for her to marry...see, nothing really. ");
			askList -= <<"What problem? ">>;
			askList = <<"Bye ">>;
		}
		case "What ceremony? "
		{
			bark("Why the wedding ceremony, of course. I could arrange it for quite soon. ");
			askList -= <<"What ceremony? ">>;
		}
		case "GOODBYE! "
		{
			bark("Then that's settled. You'll think about it and get back to me with your answer. ");
			exitConvo();
			return;
		}
		case "I met Bentic. "
		{
			if benticCacked
			{
				bark("Ah yes, he was just executed...for conducting forbidden research, if I remember rightly. He was a good fellow, too bad he got involved in such shady dealings. ");
				askList -= <<"I met Bentic. ", "bye ">>;
				askList ^= <<"What shady dealings? ", "Orlok told a story of Bentic. ", "bye ">>;
			}
			else
			{
				bark("Bentic, now there's a good fellow. Always in his library, he is. Stays out of trouble. Too bad more of our citizens aren't more like that. ");
				askList -= <<"I met Bentic. ", "bye ">>;
				askList ^= <<"Orlok told a story of Bentic. ">>;
				askList += <<"bye ">>;
			}
		}
		case "What shady dealings? "
		{
			bark("Well, you know...just, shady ones. Ones that are forbidden by Lady Mordea. Ahem, I can't say anymore than that, you know, official policy and all. ");
			askList -= <<"What shady dealings? ", "bye ">>;
			askList += <<"Orlok told a story of Bentic. ", "bye ">>;
		}
		case "Orlok told a story of Bentic. "
		{
			bark("Of course he did, he's Orlok, after all and he does enjoy his story. Didn't tell you the one about the map on Bentic's chest, did he? Well, that's nothing but hogwash. I had cause to visit Bentic in his home one day. He was wearing a robe and showed his chest quite plainly. There was no map on it. ");
			askList -= <<"Orlok told a story of Bentic. ", "bye ">>;
			askList += <<"Do you know of Blowhard's treasure? ", "bye ">>;
		}
		case "Do you know of Blowhard's treasure? "
		{
			bark("So, come for treasure, have you? Well, you're not the first young man to come to me with that look in your eye. No sirree, in fact, were I a younger man, I might take it into my head to look, myself. ");
			askList -= <<"Do you know of Blowhard's treasure? ", "bye ">>;
			askList += <<"Where would you look? ", "bye ">>;
		}
		case "Where would you look? "
		{
			bark("Well, when I was just a tyke, my father told me a story Much like one of Orlok's stories about John Blowhard. Only my father's story went this way. A bunch of trolls had taken up residence on an island. They raided neighboring villages and stole the children away to eat them. One night, the trolls came again and tried to steal the last child in the village. The child's mother was so enraged, she grabbed one of her knitting needles and killed the troll. Stratos was so impressed by this mother's defense, she turned the knitting needle into a magical sword. It is said this sword is hidden somewhere in the mountains outside Tenebrae, perhaps in Herdsman's valley. Were I looking for treasure, that's where'd I'd look.");
			askList -= <<"Where would you look? ">>;
		}
		case "I met Kilandra. "
		{
			bark("She is a crazy old thing, isn't she? ");
			askList -= <<"I met Kilandra. ", "bye ">>;
			askList += <<"Her tale is tragic. ", "bye ">>;
		}
		case "Her tale is tragic. "
		{
			bark("Oh, told you about her daughter, did she? Well, ever since that little girl died, she has not been the same. Never comes into town, never speaks to anyone. Rather pathetic, if you ask me. ");
			askList -= <<"Her tale is tragic. ">>;
		}
		case "bye "
		{
			bark("Farewell. ");
			exitConvo();
			return;
		}
		default
		{
			bark("Stay out of trouble. ");
			exitConvo();
			return;
		}
	}
