			case "You sell scrolls? "
			{
				local_m08 -= <<"You sell scrolls? ">>;
				bark("Indeed, I do. Do you wish to purchase some? ");
				wantsScrolls = 1;
				paganLore = 2;
				mythran_confirm_trade_or_lesson();
			}
			case "The city. "
			{
				bark("Ah, Tenebrae. The city was not settled until near the end of the war between the Pagans and Zealans. After the Titans defeated the Destroyer, most of the world lay in such ruin and disarray that the few people who were left on the island congregated into a single community. They called their city Tenebrae, meaning 'city of eternal twilight.' At first the Necromancers held rulership, but once Kalen became a Tempest as well, the people elected to have their leaders come from that line. ");
				local_m08 -= <<"Are they not all the same? ", "The city. ">>;
				if not titansHis
				{
					local_m08 ^= <<"Who is Kalen? ">>;
				}
			}
			case "The island. "
			{
				bark("The island is called Morgaelin, same as the mountain -- or volcano -- from which it sprang. As far as the people know, this is the only piece of land remaining after the Titans vanquished the Destroyer. ");
				local_m08 -= <<"Are they not all the same? ", "The island. ">>;
			}
			case "All of Pagan. "
			{
				if titansHis
				{
					bark("Much of this I have already told you from our discussion of Pagan's history. ");
				}
				bark("The lands of this world once spanned great distances. At that time, the people were prosperous and -- for the most part -- unified. However, when the words of warning came from a mysterious being called the Guardian, the population split into two factions: the Zealans, who believed in the ancient traditions, and Pagans, who felt that the Guardian's words meant the end of things that were.~The two factions fell to fighting against each other, while the very forces of the elements began to take form and grow. When a malevolent entity called the Destroyer attempted to conquer the world, the elements, who had amassed Titanic levels of power, rose to battle it. During the struggle, the lands were demolished, leaving only a few peoples scattered across a single island -- this island. Shortly thereafter the Zealans fell to their enemies, and the world became known as Pagan.");
				local_m08 -= <<"Are they not all the same? ", "All of Pagan. ">>;
			}
			case "Who is Kalen? "
			{
				local_m08 -= <<"Who is Kalen? ">>;
				bark("He was the first Tempest. An early hero to the people, his life as a Necromancer was filled with some amount of tragedy. When we have time I will relate the history of this world to you, then you will have a better understanding. ");
			}
			case "Enough about Pagan. "
			{
				bark("Very well. ");
				return;
			}
		}
	}
}

