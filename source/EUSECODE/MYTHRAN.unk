process [[PT_DEFAULT, referent]] MYTHRAN::mythran_recommend_history_essay()
{
	bark("Better than wasting your time and mine with a lengthy story when we could be discussing more interesting matters, let me simply suggest that you read my essay on the subject. The book should be around here somewhere. Most likely I have left it upstairs. Feel free to borrow it if you wish. ");
	return;
}

