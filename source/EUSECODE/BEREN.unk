								}
								case "The Guardian is the Destroyer. "
								{
									bark("You know not of what you speak. I will hear no more about it. ");
									local_m0C = <<"But where I am from... ", "You do not understand... ", "Wait. You must hear me out... ">>;
									local_m06 = ask(local_m0C);
									if local_m06 = ""
									{
										bark("Thank you for respecting my wishes. What else can I help you with? ");
