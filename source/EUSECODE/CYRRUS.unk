				if cyrrusJustHealed
				{
					bark("I am sorry, but I do not have the strength to perform such a service. Come back later after I have rested. ");
					askList ^= <<"I need healing. ">>;
				}
				else
				{
					bark("That is certainly no problem. ");
					healingTouch(1);
					cyrrusJustHealed = 1;
					bark("Please leave me now, I need to rest. ");
					exitConvo();
					return;
				}
			}
			case "Have you passed the Test of Wisdom? "
			{
				bark("For certes. It is only the first step on the road to Enlightenment. It was not easy by any means. ");
				askList += <<"Will you tell me the answers? ", "Where did you get the answers? ">>;
				askList -= <<"Have you passed the Test of Wisdom? ">>;
			}
			case "The Test of Centeredness was difficult? ", "Is the Test of Centeredness difficult? "
			{
				bark("Difficult? It was nearly the death of me! I fell at least five times. Fortunately Stratos saw fit to keep me and not send me to my death over the steep side. But, you'll see for yourself when you get there! ");
				askList -= <<"The Test of Centeredness was difficult? ", "Is the Test of Centeredness difficult? ">>;
			}
			case "I have passed the Tests of Wisdom and Centeredness. "
			{
				bark("You have? But you've just arrived on our island. I don't believe we've ever had anyone complete them this fast. Stratos will be so pleased with your accomplishments. Now you must find Stellos and begin on the next part of your journey. ");
				askList -= <<"I have passed the Tests of Wisdom and Centeredness. ">>;
			}
			case "I have passed the Third Test and have my Foci. "
			{
				if fociReturned
				{
					bark("That is wonderful! You must be quite excited. ");
				}
				else
				{
					bark("I am sorry I can not celebrate with you, but a terrible thing has happened. Brother Xavier has lost one of his Foci. ");
					askList ^= <<"How did it happen? ">>;
				}
				askList -= <<"I have passed the Third Test and have my Foci. ">>;
			}
			case "How did it happen? "
			{
				bark("It seems it was taken while he slept. I am sorry but I must be going. I have to help look for the missing Focus. ");
				exitConvo();
				return;
			}
			case "Have you seen Torwin? "
			{
				if torwinJumped
				{
					bark("Why, no. And, may I add, what a cruel thing to ask! ");
				}
				else if hearTruthActive
				{
					bark("No I have not. (yes I have) ");
					askList = <<"Why are you covering up for him? ", "Where is he? ">>;
				}
				else
				{
					bark("No, I haven't seen him all day. ");
				}
				askList -= <<"Have you seen Torwin? ">>;
			}
			case "Where is he? "
			{
				if hearTruthActive
				{
					bark("I do not know. (He told me he was going to go to Windy Point today for something very important.) ");
					torwinGottaJump = 1;
					Npc_schedule(((100) : DWord), u8_stack_ref(26));
				}
				else
				{
					bark("I do not know. ");
				}
				askList -= <<"Where is he? ">>;
			}
			case "Why are you covering up for him? "
			{
				if hearTruthActive
				{
					bark("I am not covering for him! (I think he is the one who took the Focus. I don't think he meant any harm by it, though. He is not a mean-spirited person) ");
				}
				else
				{
					bark("Pardon me? I am not covering up for him. That would go against all the teachings of Stratos. ");
				}
				askList -= <<"Why are you covering up for him? ">>;
			}
			case "Holy Cyrrus? "
			{
				bark("That is the name given to me by Stellos. Everyone thinks it is a grand name. ");
				askList -= <<"Holy Cyrrus? ">>;
				askList += <<"It is a grand name. ", "Everyone? ">>;
			}
			case "It is a grand name. "
			{
				bark("I am sure my father has bragged about it to everyone, including the torax! ");
				askList -= <<"It is a grand name. ">>;
				askList += <<"Your father is a herdsman? ">>;
			}
			case "Everyone? "
			{
				bark("My mother and father, the others here... why, just everyone. ");
				askList -= <<"Everyone? ">>;
			}
			case "Your father is a herdsman? "
			{
				bark("Yes, and so I would be. It's birthing time back home. My favorite time of the year. Watching the beginning of a new life, helping that new life to stand... aahhh, it is one of greatest joys in my life. But that is all behind me now. ");
				askList -= <<"Your father is a herdsman? ">>;
				askList = <<"Where are you from? ">>;
			}
			case "Where are you from? "
			{
				bark("My home is in the hills of Tenebrae. Even Argent Rock with all its finery is but a pale shadow of the beauty of Tenebrae. The ocean, the hills, the people...I miss it so. ");
				askList -= <<"Where are you from? ">>;
				askList += <<"You miss the people of Tenebrae? ", "Why are you here? ">>;
			}
			case "Why are you here? "
			{
				bark("It was discovered when I was quite young that I had a talent for healing. My mother and father were so proud. They told everyone about their brilliant child who was going to heal the world. Then my sister was injured by a kith. No matter how I tried, my meager skills were no match for her injury. She died and I vowed it would never happen again. I left home and made my way here. I've been here ever since. ");
				askList -= <<"Why are you here? ">>;
			}
			case "You miss the people of Tenebrae? "
			{
				bark("It has been my home since birth. I miss the people. Darion with all his bluff and bluster, used to carry candy in his pocket for me. Bentic tutored both Jenna and I when we were young. Oh, my beloved Jenna. I try not to think of her, it pains me so. ");
				askList -= <<"You miss the people of Tenebrae? ">>;
				askList += <<"Tell me of Jenna. ", "Tell me of Darion. ">>;
				if benticCacked
				{
					askList += <<"Bentic is dead. ">>;
				}
				else
				{
					askList += <<"Tell me of Bentic. ">>;
				}
			}
			case "Tell me of Bentic. "
			{
				bark("I miss him so. He is a kind and gentle man who's greatest loves in life are his books and his studies. He knows so much about so many things, he is fascinating to talk with. ");
				askList -= <<"Tell me of Bentic. ">>;
			}
			case "Tell me of Darion. "
			{
				bark("He talked of the day I would join the guard. I told him many times I would be a herdsman like my father. 'Nonsense,' he would say, 'you're cut out to be a guard, you have the spirit for it.' I don't know why, the guard never does anything but hang around the castle hoping Aramina will bring them a sweet from the Tempest's table! He is Jenna's father, you know. ");
				askList -= <<"Tell me of Darion. ">>;
				askList += <<"Jenna's father? ">>;
			}
			case "Jenna's father? "
			{
				bark("Yes, and in my fondest dreams, he was to be my father- in-law, for I love Jenna so. ");
				askList -= <<"Jenna's father? ">>;
			}
			case "Bentic is dead. "
			{
				bark("Oh no! Say it is not so! Oh dear! You bring me sad news of my home! Pray, how did this happen? ");
				askList -= <<"Bentic is dead. ">>;
				askList = <<"Mordea had him executed. ", "I know not ">>;
			}
			case "I know not "
			{
				bark("'Tis a sad day for me. Bentic was a dear friend. ");
				askList -= <<"I know not ", "Mordea had him executed. ">>;
			}
			case "Mordea had him executed. "
			{
				bark("The Tempest? I knew she was a hard woman, but to execute someone as gentle and harmless as Bentic? What terrible thing did he do that would anger the Tempest so? ");
				askList -= <<"Mordea had him executed. ", "I know not ">>;
				askList += <<"He conducted forbidden research. ", "I do not know ">>;
			}
			case "I do not know "
			{
				bark("I cannot imagine what terrible wrong Bentic committed that would result in his death. He was a kind and good man. ");
				askList -= <<"I do not know ">>;
			}
			case "He conducted forbidden research. "
			{
				bark("Research was what Bentic loved most. Ah, 'tis a sad day when good folks are executed for doing something which they love and brings harm to no one. ");
				askList -= <<"He conducted forbidden research. ", "I do not know ">>;
			}
			case "Tell me of Jenna. "
			{
				if jennaMet
				{
					bark("Ah, you've met her, then. Isn't she a lovely creature? I have loved her from the moment I laid eyes on her. I always dreamed she would marry me and live with me in the hills, helping tend the torax. It is funny how things never work out like we expect. ");
				}
				else
				{
					bark("She lives in Tenebrae. If you should travel there, stop in and see her. She is a lovely girl, so full of life. I would that I could marry her, but I cannot. ");
				}
				askList += <<"Why not marry her? ">>;
				askList -= <<"Tell me of Jenna. ">>;
			}
			case "Why not marry her? "
			{
				bark("Look around you, my friend. There are few enough of us here on Argent Rock. Rare are those with the talent it takes to touch the power of Stratos and use it to heal. I am one of those few. To help the people of this land I must sacrifice that which I most dearly desire...to marry my beloved Jenna and live a simple herdsman's life in the hills above Tenebrae. ");
				askList -= <<"Why not marry her? ">>;
			}
			case "What place is this? "
			{
				bark("This is Argent Rock, home of the Theurgists. ");
				askList -= <<"What place is this? ">>;
				askList += <<"Who are the Theurgists? ">>;
			}
			case "Who are the Theurgists? "
			{
				cyrrusJob = 1;
				bark("Why we are the disciples of Stratos, the Great Titan of Air. We are healers. ");
				askList -= <<"Who are the Theurgists? ">>;
			}
			case "I passed the Third Test. "
			{
				bark("I have heard. This is certainly a great occasion. Now you are ready to attempt the greatest feat of your life...to reach out and touch the power that is Stratos. ");
				askList -= <<"I passed the Third Tests. ">>;
				askList ^= <<"Touch Stratos' power? ", "The greatest feat? ">>;
			}
			case "Touch Stratos' power? "
			{
				bark("The power that gives us the ability to heal people. It is a thrilling moment when you first touch the Titan. Certainly nothing you will ever forget. ");
				askList -= <<"Touch Stratos' power? ">>;
			}
			case "The greatest feat? "
			{
				bark("You must go to Stellos. He will tell you how to reach Stratos. ");
				askList -= <<"The greatest feat? ">>;
			}
			case "I have the Breath of Wind. "
			{
				bark("That explains it then. I felt a tremor in my link with Stratos, then it was broken. I am unable to heal. ");
				askList -= <<"I have the Breath of Wind. ">>;
				askList += <<"You are unable to heal? ">>;
			}
			case "You are unable to heal? "
			{
				bark("I hope that you use the Breath of Wind for a higher purpose, for it was taken at great sacrifice to the people of this land. It is a bitter sweet time for me. ");
				askList += <<"Why bittersweet? ">>;
				askList -= <<"You are unable to heal? ">>;
			}
			case "Why bittersweet? "
			{
				bark("For if my link with Stratos is permanently broken then I can never heal the sick and injured of this land again. This would be a tragic thing for the people, however, it also would release me of my vow to Stratos, leaving me free to return to Tenebrae and marry my beloved Jenna. So while I mourn for the people, I thank you for giving my love to me. ");
				askList -= <<"Why bittersweet? ">>;
			}
			case "Will you tell me the answers? "
			{
				bark("Certainly not. That is an unthinkable thing. You must find the answers yourself as have all those seeking Enlightenment before you have. ");
				askList -= <<"Will you tell me the answers? ", "Where did you get the answers? ">>;
			}
			case "Where did you get the answers? "
			{
				bark("From the library. Oh, the hours I spent in there pouring over the old texts until the candle I was using was burned to a nub. Yes, those were difficult days. But not as difficult as the Test of Centeredness. ");
				askList -= <<"Where did you get the answers? ", "Will you tell me the answers? ">>;
				askList += <<"The Test of Centeredness was difficult? ">>;
			}
			case "I found this ring. "
			{
				bark("My goodness. That's Torwin's ring! Oh my, it belonged to his father. He showed it to everyone he met. Oh how terribly, terribly sad! You should take it to his mother. ");
				askList -= <<"I found this ring. ">>;
				askList += <<"I shall. ", "I don't think I will. ">>;
			}
			case "I shall. "
			{
				bark("I know she will be very happy. It is a kind thing you do. Give her my regards, will you? ");
				exitConvo();
				return;
			}
			case "I don't think I will. "
			{
				bark("Perhaps you are right. The shock and sadness might be too much for her. Still, I think it would be best to return it to her. ");
				askList -= <<"I shall. ", "I don't think I will. ">>;
			}
			case "The Test of Centeredness was difficult? ", "Is the Test of Centeredness difficult? "
			{
				bark("Difficult? It was nearly the death of me! I fell at least five times. Fortunately Stratos saw fit to keep me and not send me to my death over the steep side. But, you'll see for yourself when you get there! ");
				askList -= <<"The Test of Centeredness was difficult? ", "Is the Test of Centeredness difficult? ">>;
			}
			case "bye "
			{
				bark("Goodbye. ");
				exitConvo();
				return;
			}
		}
	}
	exitConvo();
}

