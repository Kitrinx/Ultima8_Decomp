				if (mordeaMet = 1) or (shaanaMet = 1) or (orlokMet = 1) or (darionMet = 1) or (rhianMet = 1)
				{
					bark("He was killed, he was. Executed at the Lady's command. I know the reasons they gave, but Toran was no blasphemer. There is tyranny in this city, that's for sure. Be careful what you speak to others. ");
				}
				else
				{
					bark("I hear he is to be killed. Executed at the Lady's command. I know the reasons they give, but Toran is no blasphemer.  There is tyranny in this city, that's for sure. Be careful what you speak to others. ");
				}
				local_m1D -= <<"What about Toran? ">>;
			}
			case "What should I do? "
			{
				if hydrosFree
				{
					bark("All I am concerned about now is pacifying the Lurker, my friend. I am sorry, but I have no time for anything else. ");
				}
				else
				{
					bark("Well, I suppose now that you are better, you should consider visiting Tenebrae. Here there is nothing, unless you wish to join me in fishing. But in Tenebrae, there is a wealth of activities and information for a soul such as yourself. Why, I know just the person there who can help you. When you get to town, visit Bentic in the library in east Tenebrae. The good sage knows practically all there is to know about our land and its people. Yes, he can certainly help you. ");
					devonSaidBentic = 1;
				}
				local_m1D = <<"Goodbye. ">>;
			}
			case "Goodbye. "
			{
				if devonMet
				{
					local_m06 = "Farewell, friend " + getName() + ", and good luck.";
					// X: reconstructed continuation; an explicit dependency sequence is equivalent.
					spawn bark(u8_string_local_address(local_m06)) -> return;
				}
				else
				{
					bark("Farewell, friend " + getName() + ", and good luck. You are welcome to stay with me for as long as you need. My food and provisions are yours until you wish to head to the city. And be careful in your travels, for I fear you will encounter much violence.");
					turnToFace(6, 10, 15);
					bark("I can already see a crowd gathering there on the docks.");
					// X: reconstructed continuation; an explicit dependency sequence is equivalent.
					spawn bark("That can mean only trouble.") -> return;
				}
				local_m1D -= <<"Goodbye. ">>;
				devonMet = 1;
				exitConvo();
				return;
			}
			case "What is going on? "
			{
				local_m08 = "I am not sure, my friend, though I must admit I am pleased to see you.  My good friend, Bentic, has been... executed. And I, myself, jailed. Yet no one will tell me why. Why, " + getName() + ". Why are these needless deaths happening? Please, " + getName() + ", you must find this out for me. I beg your assistance. What was Bentic doing that warranted death? Certainly Salkind has some explanation. He will not speak to me here, but perhaps you will find him in kind enough spirits to answer a few questions.";
				bark(u8_string_local_address(local_m08));
				metDevonInJail = 1;
				local_m0D = 1;
				local_m1D -= <<"What is going on? ">>;
				local_m1D = <<"I will help. ", "I am sorry. ">>;
			}
			case "I am sorry. "
			{
				refusedDevon = 1;
				local_m0D = 0;
				bark("You are sorry? I understand. You are too busy with your own troubles. ");
				local_m1D -= <<"I am sorry. ">>;
				local_m1D = <<"I will help. ", "Goodbye. ">>;
			}
			case "I will help. "
			{
				bark("At the moment, I can offer you only my eternal gratitude. But I hope one day to repay you for the kindness and courage you are sharing. Good luck, my friend. ");
				local_m1D -= <<"I will help. ">>;
				local_m1D -= <<"I am sorry. ">>;
				local_m1D ^= <<"Goodbye. ">>;
				helpDevon = 1;
				local_m0D = 0;
			}
			case "Greetings, Devon. "
			{
				if helpDevon
				{
					bark("Well met, friend. I hope your luck is holding out. I do not know how much longer they will keep me here, and I fear the chopping block is not out of the question. Please, continue with your quest. ");
					local_m1D -= <<"Greetings, Devon. ">>;
					local_m1D = <<"Goodbye. ">>;
				}
				else
				{
					if refusedDevon
					{
						bark("You will forgive me if I do not respond politely. The bitter taste left in my mouth from our last encounter is quite foul. Unless you are here to offer assistance, please be on your way. ");
						local_m1D = <<"I will assist you. ", "Farewell. ">>;
						local_m0C = 1;
						u8goto label_3C0E;
					}
				}
				u8label label_3C0E:
			}
			case "Farewell. "
			{
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn bark("Begone, coward. ") -> return;
				exitConvo();
				return;
			}
			case "I will assist you. "
			{
				helpDevon = 1;
				bark("I cannot tell you how pleased I am to see your change of heart. I found it difficult to so often curse the name of one I knew to be kind and courageous. At the moment, I can but offer you my eternal gratitude. But I hope one day to repay you for your deeds. Good luck, my friend. ");
				local_m1D -= <<"I will assist you. ">>;
				local_m1D = <<"Goodbye. ">>;
			}
			case "I need the Blackrock fragment. "
			{
				bark("I am sorry, my friend, but for once it is me who does not understand you. What is this Blackrock fragment? ");
				local_m1D -= <<"I need the Blackrock fragment. ">>;
				local_m1D ^= <<"The Tear of the Seas. ", "Who would know its location? ">>;
			}
			case "Who would know its location? "
			{
				bark("To answer that, I must know what it is you are talking about. ");
				local_m1D -= <<"Who would know its location? ">>;
			}
			case "The Tear of the Seas. "
			{
				bark("I have not heard of this item.  What exactly is this Blackrock Tear? ");
				local_m1D -= <<"The Tear of the Seas. ">>;
				local_m1D ^= <<"It is a large, dark stone. ">>;
			}
			case "It is a large, dark stone. "
			{
				bark("Your description is rather vague. Considering the once-active state of the volcano, I do not think you will get far asking for a large black-colored rock. I would even be suprised if -- wait! Despite my words I might be able to assist you. Years ago, I found myself casting my nets in a new area. The catch was plentiful, I remember, and when I pulled in my nets one time, I found such a stone within. The rock was made of an unusually hard substance, even more resistant than obsidian. I thought it so peculiar at the time that I kept it. I still have it if you wish to see it.");
				local_m1D -= <<"It is a large, dark stone. ">>;
				local_m1D = <<"Yes, I do. ", "No, I do not. ", "May you farewell. ">>;
				local_m0C = 1;
				devonMentionedTear = 1;
			}
			case "Yes, I do. "
			{
				bark("I believe it is locked away in a chest in my study, in the southwest corner of the palace. Here is the key. You may take it for whatever purpose you need.~ Oh, yes, there is something else I wanted to mention to you. You have been here for sometime and yet I do not know where you have managed to find accomodations. The least I can do is have you stay at Salkind's house. There you should find food and lodging, and most likely even a little money. You have done so much for the city, I feel that we owe you no less.");
				local_m1D -= <<"Yes, I do. ", "No, I do not. ">>;
				local_m24 = Avatar.getX();
				local_m22 = Avatar.getY();
				local_m20 = Avatar.getZ();
				if class_0581_give(1, 82, 0, 90, 1)
				{
					bark("I hope this key helps. ");
				}
				else
				{
					Item_create(0, 82, u8_local_address(local_m15_w01));
					local_m15.setQuality(90);
					local_m17 = Avatar.getEquip(6);
					local_m15.pop(local_m17);
					bark("I hope this key helps. ");
				}
			}
			case "No, I do not. "
			{
				bark("Very well, though I find it odd that you mentioned it then. Should you change your mind, I believe it is locked away in a chest in my study, in the southwest corner of the palace. Here is the key. You may take it for whatever purpose you need.~ Oh, yes, there is something else I wanted to mention to you. You have been here for sometime and yet I do not know where you have managed to find accomodations. The least I can do is have you stay at Salkind's house. There you should find food and lodging, and most likely even a little money. You have done so much for the city, I feel that we owe you no less.");
				local_m1D -= <<"Yes, I do. ", "No, I do not. ">>;
				local_m29 = Avatar.getX();
				local_m27 = Avatar.getY();
				local_m25 = Avatar.getZ();
				if class_0581_give(1, 82, 0, 90, 1)
				{
					bark("I hope this key helps. ");
				}
				else
				{
					Item_create(0, 82, u8_local_address(local_m15_w01));
					local_m15.setQuality(90);
					local_m17 = Avatar.getEquip(6);
					local_m15.pop(local_m17);
					bark("I hope this key helps. ");
				}
			}
			case "May you farewell. "
			{
				local_m2B = "Goodbye, " + getName() + ", and good luck!";
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn bark(u8_string_local_address(local_m2B)) -> return;
				exitConvo();
				return;
			}
			case "The Lurker is free! "
			{
				if devonJailed and (not devonInRule)
				{
					bark("While terrible as that might be, I am more concerned with my current situation. Perhaps later, my friend, I will be more interested in that. ");
				}
				else
				{
					bark("I had feared as much. When the torrential rains began and the people came to me, I could not stop it. Then I knew something was wrong. At first, I had hopes that you simply found another Tempest, one who was older. Yet somehow\x09I knew, I felt, that was not the case. Tell me, friend, how did this come to pass? ");
					local_m1D = <<"Twas my fault. ", "I know not. ", "Goodbye. ">>;
				}
				devonHeardLurker = 1;
				local_m1D -= <<"The Lurker is free! ">>;
			}
			case "Twas my fault. "
			{
				bark("That does not surprise me. From the day I cut you free of my fishing nets, I knew of the luck that followed you. Whether it is good luck or bad I did not know. Nor, for that matter, am I sure now. Nevertheless, the rains must cease or the land will flood again, as in the days of Kalen and the wars with the Zealans. And, my friend, I believe it is up to you to end this cataclysm. Though I am loath to suggest this, perhaps the Sorcerers who dwell across the river of lava in the catacombs can help. ");
				local_m1D -= <<"Twas my fault. ", "I know not. ">>;
			}
			case "I know not. "
			{
				bark("This is terrible. With Hydros free and the rain falling in torrents, the land will surely flood. We have not the time nor the ability to move to the safety of higher ground! ");
				local_m1D -= <<"Twas my fault. ", "I know not. ">>;
			}
		}
	}
}

