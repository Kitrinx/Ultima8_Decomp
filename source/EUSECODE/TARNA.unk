				local_m0B -= <<"No. ">>;
				bark("Then prepare to answer to my blade! ");
				exitConvo();
				Npc_setTarget(1, u8_stack_ref(8));
				return;
			}
			case "I do not remember. "
			{
				if local_m07
				{
					bark("Well now, that's a little more like it. ");
				}
				bark("Had a bit too much of Orlok's brew, eh? Well, you just watch yourself and stay out of trouble, and we'll have no quarrel with you. ");
				bark("Now tell me, where do you hail from? ");
				if local_m08
				{
					local_m0B -= <<"Yes. ", "No. ">>;
				}
				if local_m09
				{
					local_m0B -= <<"I said, not your concern! ">>;
				}
				local_m0B -= <<local_m06, "I come in peace. ", "My business, not yours. ", "I do not remember. ">>;
				local_m0B ^= <<"The beach. ", "A place far away. ", "Another world. ">>;
			}
			case "The beach. "
			{
				bark("A fisherman, then? You do not dress like one who makes his living pulling nets from the sea. Then your business in the city is...? ");
				local_m0B -= <<"The beach. ", "A place far away. ", "Another world. ">>;
				local_m0B += <<"I do not know. ", "To return home. ", "To leave this place. ", "To make money. ">>;
			}
			case "A place far away. "
			{
				bark("Another island? I admit your clothing is unusual, but I was not aware there were other cities. Well, I suggest you quickly learn the laws and customs of -this- city. What is your business in the city? ");
				local_m0B -= <<"The beach. ", "A place far away. ", "Another world. ">>;
				local_m0B += <<"I do not know. ", "To return home. ", "To leave this place. ", "To make money. ">>;
			}
			case "Another world. "
			{
				bark("I may appear to be just a simple guard to you, but I outgrew such fairytales years ago. I suggest you change your tone with me or I will see your worthless hide resting on the inside of a jail! Now, if you would, tell me your business in the city. ");
				local_m0B -= <<"The beach. ", "A place far away. ", "Another world. ">>;
				local_m0B += <<"I do not know. ", "To return home. ", "To leave this place. ", "To make money. ">>;
			}
			case "I do not know. "
			{
				local_m0B -= <<"I do not know. ", "To return home. ", "To leave this place. ", "To make money. ">>;
				if tarnaAvaName
				{
					bark("Well you had best find out, " + getName() + ". We do not like trouble in the city.");
				}
				else
				{
					bark("Well you had best find out, stranger. We do not like trouble in the city. ");
				}
				bark("You may go about your business. Please move along and do not disturb the widow until after I have escorted her from the docks. ");
				tarnaMet = 1;
				exitConvo();
				return;
			}
			case "To return home. ", "To leave this place. "
			{
				local_m0B -= <<"I do not know. ", "To return home. ", "To leave this place. ", "To make money. ">>;
				bark("Then what in the Lady's name are you doing wandering around here? I suggest you quickly find your way. ");
				bark("You may go about your business. Please move along and do not disturb the widow until after I have escorted her from the docks. ");
				tarnaMet = 1;
				exitConvo();
				return;
			}
			case "To make money. "
			{
				local_m0B -= <<"I do not know. ", "To return home. ", "To leave this place. ", "To make money. ">>;
				bark("Whose business is not? While you are at it, buy yourself some better attire. ");
				bark("You may go about your business. Please move along and do not disturb the widow until after I have escorted her from the docks. ");
				tarnaMet = 1;
				exitConvo();
				return;
			}
		}
	}
}

