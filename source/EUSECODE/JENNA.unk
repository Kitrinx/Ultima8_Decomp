			{
				bark("It is quite a way from here. I'm not exactly sure, but I know you must travel through the cemetary to get there. ");
				askList -= <<"Where is Argentrock? ">>;
			}
			case "Tell me of Cyrrus. "
			{
				bark("He was a herdsman's son. He wanted to marry me and live in the hills tending torax. Now torax may be wonderful to him, but I think they are stupid and they smell. I was so glad when he went to Argentrock. ");
				askList -= <<"Tell me of Cyrrus. ">>;
				askList += <<"Why did he go to Argentrock? ", "Where is Argentrock? ">>;
			}
			case "Why did he go to Argentrock? "
			{
				bark("They say he has some talent for healing. He always did feel closer to Stratos than he did to Hydros, though he didn't tell his family that. They would have been very angry. Well, I don't know if he ever became a healer, I'm just glad he is gone. ");
				askList -= <<"Why did he go to Argentrock? ">>;
			}
			case "I met your father. "
			{
				bark("Yes, he is quite a man. He tries to marry me off to everyone who comes through town. He's afraid I'm going to be an old maid. ");
				askList -= <<"I met your father. ">>;
				askList += <<"An old maid? ">>;
			}
			case "Who is your father? "
			{
				bark("Darion, the Arms Master and Captain of the Palace Guard, is my father. He thinks I am going to be an old maid and tries to marry me off to everyone who comes around. ");
				askList -= <<"Who is your father? ">>;
				askList += <<"An old maid? ">>;
			}
			case "An old maid? "
			{
				bark("I am NOT an old maid! How dare you say that?! You are just like my father! I can't kill him, but I can you and I just might. Now, get out while I still feel civil! ");
				jennaPissed = 1;
				exitConvo();
				return;
			}
			case "It is a nice blade. "
			{
				bark("Yes, it is a fine blade, a wondrous blade. Have you ever seen finer? ");
				askList -= <<"It is a nice blade. ">>;
				askList = <<"yes ", "no ">>;
			}
			case "no "
			{
				bark("It's all I have left from my grandfather. Before he died, he gave me this sword and told me to wear it with pride. And I always have. ");
				askList -= <<"yes ", "no ">>;
				askList ^= <<"Where did you learn to wield it? ">>;
			}
			case "Where did you learn to wield it? "
			{
				bark("My father taught me. He always wanted a son, but all he got was me. So he taught me. He is determined to marry me off, though. ");
				askList -= <<"Where did you learn to wield it? ">>;
			}
			case "yes "
			{
				bark("You wretch! How dare you insult my grandfather's memory? You will pay for your disrespect! Now get out of my sight, before I decide to show you just how fine this blade is! ");
				askList -= <<"yes ", "no ">>;
				jennaPissed = 1;
				exitConvo();
				return;
			}
			case "What do you do? "
			{
				jennaJob = 1;
				bark("Well, for now I'm a barmaid. Can I get you a drink or something to eat? ");
				askList = <<"I'd like something to drink, please. ", "I'd like something to eat. ", "Nothing, thank you. ">>;
				if not barmaidForNow
				{
					askList += <<"A barmaid for now? ">>;
				}
			}
			case "A barmaid for now? "
			{
				barmaidForNow = 1;
				bark("Yes. It was the only job I could find at short notice. What I really want to do is go adventuring, like you. Oh, how I would like to see something of the world beyond this smelly village. ");
				askList = <<"Smelly village? ", "Job at short notice? ", "See the world? ">>;
			}
			case "Smelly village? "
			{
				bark("Yes, ugh. Can you not smell it? The rancid odor of fish combined with the nasty smell of those stupid torax. Sometimes I think that even if I left the smell would still be in my blood. It's terrible. ");
				askList -= <<"Smelly village? ">>;
			}
			case "Job at short notice? "
			{
				bark("Well, see, my father wanted me married. He seems to think that a woman can't support herself. She must have a husband to make her a complete person. Well, just to prove to him I could do it, I got this job. It's not much, but it got me out of the house. ");
				askList -= <<"Job at short notice? ">>;
			}
			case "See the world? "
			{
				bark("Ah, what I wouldn't give to see it all, but I can't. ");
				askList -= <<"See the world? ">>;
				askList += <<"What is there to see? ", "Why can't you see it? ">>;
			}
			case "What is there to see? "
			{
				bark("Why, just the whole world. I've heard there are sorcerers who can call up the forces of fire and ancient ruins where hordes of treasure await anyone brave enough to fight the evil creature guarding it. ");
				askList -= <<"What is there to see? ">>;
			}
			case "Why can't you see it? "
			{
				bark("Because I am a woman, so they say. ");
				askList -= <<"Why can't you see it? ">>;
				askList += <<"Why can't a woman adventure? ">>;
			}
			case "Why can't a woman adventure? "
			{
				bark("There are those who say only young men are interested in adventuring, and women are only interested in cooking and shopping. Well, I say they are wrong! There mayn't be many of us, but we are here. Maybe someday they will realize it. Until then, how about that drink? ");
				askList = <<"I'd like something to drink, please. ", "I'd like something to eat. ", "Nothing, thank you. ">>;
			}
			case "Yes, what do you have to drink? "
			{
				buyDrink();
			}
			case "Nothing, thank you. ", "No, thank you. "
			{
				bark("Well, If you change your mind, just let me know. ");
				askList = <<"Why do you carry a sword? ", "Do you live here? ">>;
			}
			case "I'd like something to eat. "
			{
				askList -= <<"I'd like something to eat. ">>;
				buyFood();
			}
			case "Do you live here? "
			{
				bark("Yes, all my life. I was born not far from the cemetery. ");
				askList = <<"Tell me about the cemetery. ", "How old are you? ", "I'd like something to drink, please. ", "I'd like something to eat. ", "Nothing, thank you. ">>;
			}
			case "How old are you? "
			{
				bark("What a question! Why, I'm old enough to know how to use this sword! And I might be tempted to use it on you if you don't learn better manners! ");
				jennaPissed = 1;
				exitConvo();
				return;
			}
			case "Tell me about the cemetery. "
			{
				bark("I do not like the place. 'Tis haunted. ");
				askList ^= <<"Where is it? ", "Haunted? ">>;
				askList -= <<"Tell me about the cemetery. ">>;
			}
			case "Where is it? "
			{
				bark("It is on the other side of Tenebrae. You will have to head east from here, going right past the Tempest's keep, through the east side of town, then down a long, dangerous road. ");
				bark("I wouldn't go there if I were you. ");
				askList -= <<"Where is it? ">>;
				askList ^= <<"Why not go there? ">>;
			}
			case "Haunted? "
			{
				bark("Yes, with the ghosts of those horrid Necromancers. ");
				askList -= <<"Haunted? ">>;
			}
			case "Why not go there? "
			{
				bark("It's a terrible place, a frightening place. The Necromancers used to be there. Terrible people they are, study dead bodies. Some say they even eat them! Only one person I know of travels there willingly and that is Mythran. ");
				askList = <<"Tell me about the Necromancers. ", "They study dead bodies? ", "Tell me of Mythran. ", "I'd like something to drink, please. ", "I'd like something to eat. ">>;
			}
			case "Tell me of Mythran. "
			{
				bark("Mythran is an old hermit that lives on the Plateau. Some call him a sage, but I think he wields magic. Occasionally he comes into town. I guess he buys things for all those scrolls he makes. ");
				askList -= <<"Tell me of Mythran. ">>;
				askList += <<"Scrolls? ">>;
			}
			case "Scrolls? "
			{
				bark("Magical scrolls, I think. Why, once I saw him read from one and unlock the door to the palace when I KNEW it was locked. I don't know what he was doing in there, and I didn't ask. Best to just keep quiet, if you ask me. ");
				askList -= <<"Scrolls? ">>;
				mythranScrolls = 1;
			}
			case "Tell me about the Necromancers. "
			{
				bark("Great power they have, power over life and death. I shiver to think about it. ");
				askList -= <<"Tell me about the Necromancers. ">>;
			}
			case "They study dead bodies? "
			{
				bark("That's why they live in the cemetery, so they always have a fresh supply. I think the ghosts of their victims are there, looking for their bodies. ");
				askList -= <<"They study dead bodies? ">>;
			}
			case "That's a pretty name. "
			{
				bark("If it is a lady's company you are after, then I am afraid you have come to the wrong establishment. ");
				askList -= <<"That's a pretty name. ">>;
			}
			case "I am sorry if I upset you. "
			{
				bark("I have a long memory for slights. It is only out of respect for Orlok that I will hold my temper. ");
				askList -= <<"I am sorry if I upset you. ">>;
				askList ^= <<"I'd like something to drink, please. ", "I'd like something to eat. ">>;
			}
			case "Just try it! "
			{
				bark("You animal! I will not disgrace Orlok's trust in me by fighting in his tavern. Now get out! ");
				exitConvo();
				return;
			}
			case "Good day to you, Jenna. "
			{
				bark("What do you mean, 'good day'?! Can you not see what is happening? The dead have left their graves and are walking the streets of Tenebrae! Darion needs my sword, I have no time to chat now! ");
				exitConvo();
				sendJennaToLunch = 1;
				return;
			}
			case "bye "
			{
				bark("Good day to you. ");
				exitConvo();
				return;
			}
		}
	}
	exitConvo();
}

