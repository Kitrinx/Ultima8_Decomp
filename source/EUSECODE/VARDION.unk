				local_m06 ^= <<"You extort from the Tenebraens. ", "Shrewd bargaining on both sides. ">>;
			}
			case "What does the Master research? "
			{
				bark("That is not your business. And don't bother to ask him. He won't tell you and will most likely be angered by your interruption. And if he is angry, I will be angry. Do you take my meaning? ");
				local_m08 = askYesNo(2);
				if local_m08 = 1
				{
					bark("Good. I'm glad that you do. ");
				}
				else
				{
					bark("Well, then. Let me be more explicit. If you anger Malchir, it is my duty to see that the source of his irritation is removed. Forcibly if necessary. ");
				}
				local_m06 -= <<"What does the Master research? ">>;
			}
			case "Spellcraft? Tell me more of this. "
			{
				bark("Spells are our means of releasing and controlling the power of Fire. ");
				local_m06 -= <<"Spellcraft? Tell me more of this. ">>;
				if not local_m0E
				{
					local_m06 ^= <<"Tell me of the Fire. ">>;
				}
			}
			case "Tell me more of Earth. "
			{
				bark("Earth is useful to Fire. It forms the channels through which Fire flows and provides the fuel by which it burns. The Mountain King and Lord of Flame have almost no conflict of wills. ");
				local_m06 = <<"Farewell. ">>;
				if not local_m0E
				{
