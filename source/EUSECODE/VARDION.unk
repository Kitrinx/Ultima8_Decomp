			}
			case "Father of Daemons? "
			{
				bark("Yes. All Daemons owe allegiance to Pyros for they are born when a life is ended in flames. ");
				local_m06 -= <<"Father of Daemons? ">>;
				if not local_m13
				{
					local_m06 ^= <<"Who is Pyros? ">>;
				}
			}
			case "You extort from the Tenebraens. "
			{
				bark("With that single statement you have proven your total lack of understanding of our position. Perhaps I should introduce you to our patron Titan personally. I am quite sure that the Lord of Flame could teach you our value. ");
				vardionMad = 1;
			}
			case "Shrewd bargaining on both sides. "
			{
				if not vardionRefused
				{
					bark("Your perceptions are both insightful and correct. Perhaps you have what it takes to become a Sorcerer. Does this prospect intrigue you? ");
					local_m08 = askYesNo(2);
					if local_m08 = 1
					{
						bark("Excellent! I will personally see to your tutoring... that is after you perform one small service for me. ");
						local_m06 = <<"And what might that be? ", "I see. You need a lackey. ", "Wait. I only said I was intrigued. ", "Whatever you want, I'll do. ">>;
					}
					else
					{
						if local_m08 = 0
						{
							bark("I see. You are one who is willing to be a kith brought to slaughter. The Fire does not burn in your heart as it does in mine. ");
						}
						else
						{
							bark("Your lack of interest is echoed by mine. I don't really think you have what it takes to be one of us, anyway. ");
						}
						vardionMad = 1;
					}
				}
				else
				{
					bark("So you have said before. Have you reconsidered your decision not to assist me? Will you seek the knowledge I wish? ");
					local_m06 = <<"Yes, I am prepared. ", "I am sorry, but I must decline. ", "I won't do your dirty work! ">>;
				}
			}
			case "Tell me of the Mountain King? "
			{
				bark("Of course, how could one be born in Pagan and not know of the Earth Titan. His Necromancers attend to the dead and put them beneath the ground to become his servants. His dominion is over the land and death. ");
				local_m06 -= <<"Tell me of the Mountain King? ">>;
				local_m06 ^= <<"What do you know of Necromancers? ">>;
				local_m16 = 1;
			}
			case "Tell me of the Lurker? "
			{
				bark("That foul entity long ago attempted to claim all the lands beneath her dark waters. She was thwarted by a Necromancer who became the first Tempest. Were it not for the Tempests, we Sorcerers would have no other choice than to release the Lord of Flame to do battle with her. ");
				local_m06 = <<"Farewell. ">>;
				if not local_m14
				{
					local_m06 ^= <<"What do you know of Necromancers? ">>;
