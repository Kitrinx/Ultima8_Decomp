				if not local_m12
				{
					local_m06 ^= <<"Who is the Lord of Flame? ">>;
				}
			}
			case "What can you say of Water? "
			{
				bark("That element is anathema to Fire as the Lurker is the nemesis of the Lord of Flame. ");
				local_m06 = <<"Farewell. ">>;
				if not local_m0E
				{
					local_m06 ^= <<"Tell me of the Fire. ">>;
