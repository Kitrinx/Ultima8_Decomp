				}
				local_m13 = 1;
			}
			case "Hydros, who is that? "
			{
				bark("That accursed name belongs to the Lurker, Titan of Water. ");
				local_m06 -= <<"Hydros, who is that? ">>;
				if not local_m15
				{
					local_m06 ^= <<"Tell me of the Lurker? ">>;
				}
			}
			case "Who would Lithos be? "
			{
				bark("He is called the Mountain King and is the Titan of Earth. ");
				local_m06 -= <<"Who would Lithos be? ">>;
				if not local_m16
				{
					local_m06 ^= <<"Tell me of the Mountain King? ">>;
				}
			}
			case "Tell me more of Stratos. "
			{
				bark("She is the Titan of Air and is followed by the Order of Enlightment. A group of misguided mages, called Theurgists, led by a blind, old man. ");
				local_m06 = <<"Order of Enlightment? ", "What do you know of Theurgists? ", "Tell me of this 'blind, old man.' ", "Farewell. ">>;
			}
			case "And what might that be? "
			{
				bark("I will tell you only once a deal has been struck. Fear not. I won't make you do something you will regret. Are you prepared to undertake my task? ");
				local_m06 = <<"Yes, I am prepared. ", "Let me think on it more. ", "I won't do your dirty work! ">>;
				vardionOffer = 1 + vardionOffer;
			}
			case "I see. You need a lackey. "
			{
				bark("I have no need of a lackey. The task I require to be fulfilled will take skill and guile. And if you think of yourself as a lackey, I have no need of you. ");
				vardionMad = 1;
			}
			case "Wait. I only said I was intrigued. "
