			bark("Go! You have killed my closest comrade! What else would you have of me? Leave me alone! ");
		}
		else if ticked = 2
		{
			bark("If you speak to me again, I shall allow you to feel the agony that you visited upon my friend! Leave or die! ");
		}
		else
		{
			setTarget(1);
		}
		ticked = 1 + ticked;
	}
	else
	{
		if not local_m02
		{
			bark("Now that Vardion has allowed you to join us, you should learn as much from him as you can. Vardion always says that a moment spent in study is worth a day spent at play. ");
		}
		else if local_m02 = 1
		{
			bark("I thank you for helping to destroy that conniving kith, Bane. She would have driven the Sorcerers into open war with the Tenebraens. ");
		}
		else
		{
			bark("Prepare for the Trials of the Obsidian Fortress as best as you can. You are not allowed to leave once you have entered. ");
		}
		bark("Forgive me, for I can speak no more at the moment, matters weigh heavily upon my mind... Farewell. ");
	}
}

// Derived: routine 0x22C2, event mask 0x00000000.
// R: behavior-derived callable name.
// E/R: an incoming spawn and no synchronous call prove the process kind.
process [[PT_DEFAULT, referent]] GORGROND::gorgrond_grovel_to_master()
{
	realDoAnim(49, getDir());
	if not gorgrondGroveled
	{
		bark("Master! I am not worthy. Forgive my lack of attentiveness. I will return to my studies. There is no need for punishment. I promise that my performance will improve. You'll see. ");
		gorgrondGroveled = 1;
	}
	else
	{
		bark("Forgive me. I have offended you. I never seem to do things right. I will redouble my efforts to make your faith in me not seem misplaced. ");
	}
	wait(100);
	realDoAnim(50, getDir());
}

