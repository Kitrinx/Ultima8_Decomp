				askList -= <<"How does he torment you? ">>;
				askList = <<"yes ", "no ">>;
			}
			case "yes "
			{
				bark("Oh,...well...I guess perhaps some find it humorous. I must be back to my chores now. ");
				exitConvo();
				return;
			}
			case "no "
			{
				bark("No? Really? Truly, I didn't find it very humorous either. But he finds it hilarious. So, I smile and try my best to stay out of his way. There is precious little I can do. ");
