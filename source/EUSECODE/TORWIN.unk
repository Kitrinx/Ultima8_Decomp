				bark("I needed the magic in it for my father. ");
				askList -= <<"Only borrowed it? ", "Did not steal it? ">>;
				askList = <<"the magic in it? ", "your father? ">>;
			}
			case "the magic in it? "
			{
				bark("Foci are very strong lines to the great Stratos. I thought that perhaps with two, I might be able to draw twice as much power from the great Air Titan. ");
				askList -= <<"the magic in it? ">>;
			}
			case "your father? "
			{
				bark("Yes, my father. His name is....er,..was Toran. He lived in Tenebrae, my home town. He's dead now, killed by that evil Mordea. ");
				askList -= <<"your father? ">>;
				askList ^= <<"Toran was your father? ", "Why did Mordea kill him? ">>;
			}
			case "Toran was your father? "
			{
				bark("Yes. He was a good man, not afraid to speak out for what he believed...and he was killed for it. ");
				askList -= <<"Toran was your father? ">>;
			}
			case "Why did Mordea kill him? "
			{
				bark("That murdering bitch! She had him executed for simply speaking his mind. Is that right? Can a man's life be snuffed out for mere words? Is that right, I ask you!? ");
				askList -= <<"Why did Mordea kill him? ">>;
				askList ^= <<"I saw his execution. ">>;
				if mordeaDead
				{
					askList ^= <<"Mordea is dead. ">>;
				}
			}
			case "I saw his execution. "
			{
				bark("Then you saw as his head was severed from his body with the single swing of the executioner's ax. In that instant, the most important man in my life was taken from me, and I could do nothing about it... not then anyway. ");
				askList -= <<"I saw his execution. ">>;
				if mordeaDead
				{
					askList += <<"You could do nothing? ">>;
				}
				else
				{
					askList += <<"You could do nothing about it? ">>;
				}
			}
			case "You could do nothing? "
			{
				bark("I could do nothing, just as I could do nothing to stop you surpassing my deeds here at Argentrock. Until you arrived, I was the quickest learner and the most clever with the magic. You stole that from me, but I will still have my revenge. No, that is mine and mine alone. Do you hear me? ");
				askList -= <<"You could do nothing? ">>;
				askList += <<"revenge ">>;
			}
			case "Mordea is dead. "
			{
				bark("She is dead? This can not be! I was to kill her! ~You have stolen from me every thing. I was the best student here until you arrived. ~I was the quickest learner and the cleverest with the magic. ~You stole that from me, and now you have stolen my revenge! ");
				askList -= <<"Mordea is dead. ">>;
				askList ^= <<"revenge ">>;
			}
			case "revenge "
			{
				bark("I will still have my revenge! I will bring my father back to life! I will bring him back from the Pit of Death! ");
				askList -= <<"revenge ">>;
				askList += <<"Your father is with the Lurker. ">>;
			}
			case "Your father is with the Lurker. "
			{
				bark("YOU LIE! He is in the Pit of Death and I SHALL BRING HIM BACK! Do you hear? I shall! And I shall do it now! ");
				bark("Why, I don't need this extra focus at all! ");
				killProcess(26, PT_ANIM);
				realDoAnim(AS_CLIMB_5, 2);
				x = getX() + 32;
				y = getY();
				z = getZ() + 24;
				Item_create(9, 396, u8_local_address(local_m12_w01));
				foci.setQuality(1);
				foci.pop(x, y, z);
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn foci.hurl(15, -30, 0, 3) -> return;
				x = getX() + 32;
				y = getY();
				z = getZ() + 24;
				Item_create(0, 832, u8_local_address(local_m12_w01));
				foci.pop(x, y, z);
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn foci.hurl(15, -30, 5, 2) -> return;
				realDoAnim(AS_CLIMB_4, 2);
				wait(30);
				bark("I am strong enough to do it on my own... ");
				bark("And I will! I'm coming for you, father!! ");
				torwinJumped = 1;
				solvedMystery = 1;
				hasXavierFoci = 1;
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn class_041A_torwinRun(this) -> return;
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn Item_bark(u8_string_address("Torwin, wait! "), u8_stack_ref(1)) -> return;
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn class_041A_avatarRun(this) -> return;
				return;
			}
			case "You could do nothing about it? "
			{
				bark("Not then, but with what I have learned here, I will be able to make things right again! ");
				askList -= <<"You could do nothing about it? ">>;
				askList += <<"How will you make things right? ">>;
			}
			case "How will you make things right? "
			{
				bark("I will use the magic from Stratos to bring my father back to life. I will have my revenge! ");
				askList -= <<"How will you make things right? ">>;
				askList += <<"revenge ">>;
			}
			case "bye "
			{
				bark("Goodbye. ");
				exitConvo();
				return;
			}
		}
	}
}

