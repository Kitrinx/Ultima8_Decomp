			}
		}
	}
	if local_m02
	{
		turnToFace(0, 0, 10);
		realDoAnim(55, 0);
		turnToFace(getDirToItem(Avatar:Referent), 0, 10);
		bark("There, your focus is finished. Mighty fine craftsmanship, no? ");
		class_0581_give(1, 396, local_m02 - 1, 0, 1);
	}
	else
	{
		bark("If you don't want a focus, don't ask me to make one! ");
		class_0581_give(1, 586, 0, 0, 1);
		return;
	}
	return;
	u8label label_6B87:
	bark("What! You don't have the ore! I can't make you a focus unless you supply me with the proper materials! ");
	return;
}

