		{
			bark("Well, if you must know, my Focus of healing is missing. ");
			askList -= <<"What has happened? ">>;
			askList += <<"Focus is missing? ">>;
		}
		case "Focus is missing? "
		{
			bark("Yes, it is missing. What a tragic mishap. I hope I have just mislaid it, but I fear it is stolen. ");
			askList -= <<"Focus is missing? ">>;
			askList = <<"mislaid it? ", "stolen? ">>;
		}
		case "mislaid it? "
		{
			bark("I cannot imagine I simply lost it. It is far too important to me for such an oversight. ");
			askList -= <<"mislaid it? ">>;
		}
		case "stolen? "
		{
			bark("If it was, indeed, stolen, it is a tragedy beyond belief. Theft goes against all of Stratos' doctrine. It goes against all we have tried to teach here. ");
			askList -= <<"stolen? ", "mislaid it? ">>;
			askList += <<"When did you last see your Focus? ">>;
		}
		case "When did you last see your Focus? "
		{
			bark("It was only a night ago. I worked very late that night. When I went to bed, I laid my Focus on the chest in my bedroom, just like I always do. When I awoke in the morning, the Focus of healing was gone. Now, I am a very light sleeper. The person who took it must be able to move virtually silently, for the slightest noise would have awoken me. ");
			askList -= <<"When did you last see your Focus? ">>;
			askList += <<"Do you know who took it? ">>;
		}
		case "Do you know who took it? "
		{
			bark("That's ridiculous! If I knew who took it, I would go get it back! Fortunately, there are spells provided by Stratos that will help me learn what happened to it. ");
			askList -= <<"Do you know who took it? ">>;
		}
		case "I have met Torwin. "
		{
			if torwinJumped
			{
				bark("Yes. His death is quite tragic. ");
			}
			else
			{
				bark("Strange young man. For a while, I thought quite highly of him. Until you arrived, he was the best student we'd ever had. But... ");
				askList = <<"Strange young man? ", "Best student? ">>;
			}
			askList -= <<"I have met Torwin. ">>;
		}
		case "Strange young man? "
		{
			bark("He was always unusual. We often find him standing in the shadows outside different houses. What he is doing, we can only guess. When confronted, he offers no explanation, just wanders off. He has recently taken an interest in the Resurrection spell. ");
			askList -= <<"Strange young man? ">>;
			askList += <<"Resurrection spell? ">>;
		}
		case "Resurrection spell? "
		{
			bark("Yes, it is possible to bring the dead back to life if the proper conditions are met. ");
			askList -= <<"Resurrection spell? ">>;
			askList += <<"What proper conditions? ">>;
		}
		case "What proper conditions? "
		{
			bark("It will cost you your eyesight. This is why Stellos is blind. Because of this high price, Stratos only gives that spell to one Adept at a time. It is, afterall, a very dangerous spell. ");
			askList -= <<"What proper conditions? ">>;
			askList += <<"Dangerous spell? ">>;
		}
		case "Dangerous spell? "
		{
			bark("Most certainy, for to cast it, one must journey to the City of the Dead and face the minions of Lithos. More than one caster in our history has not survived that encounter. ");
			askList -= <<"Dangerous spell? ">>;
		}
		case "Best student? "
		{
			spokeAboutTorwinX = 1;
			if torwinJumped
			{
				bark("Well, before he died. ");
			}
			else
			{
				bark("Well, he was until he reached the Third Test. For some reason he could not pass it. He has tried a number of times. I have heard he is trying to find a way to reach Stratos and hear the Mystic Voice without passing that third test. ");
				askList -= <<"Best student? ">>;
			}
		}
		case "How terrible about Torwin. "
		{
			bark("It is said that pride goes before a fall. ");
			askList -= <<"How terrible about Torwin. ">>;
		}
		case "I have met Holy Cyrrus. "
		{
			if torwinJumped
			{
				if hearTruthActive
				{
					bark("He is a nice young man. (I think he is soft and a bit of a sissy.) I have high hopes for his abilities. (He will never make it as an Adept. I bet he's back to his torax in a month.) He and Torwin were very good friends. (I think they spent too much time together and not enough time on their studies.) ");
					askList -= <<"I have met Holy Cyrrus. ">>;
				}
				else
				{
					bark("He is a nice young man. I have high hopes for his abilities. He and Torwin were very good friends. ");
					askList -= <<"I have met Holy Cyrrus. ">>;
				}
			}
			else if hearTruthActive
			{
				bark("He is a nice young man. (I think he is soft and a bit of a sissy.) I have high hopes for his abilities. (He will never make it as an Adept. I bet he's back to his torax in a month.) He and Torwin are very good friends. (I think they spend too much time together and not enough time on their studies.) ");
				askList -= <<"I have met Holy Cyrrus. ">>;
			}
			else
			{
				bark("He is a nice young man. I have high hopes for his abilities. He and Torwin are very good friends. ");
				askList -= <<"I have met Holy Cyrrus. ">>;
			}
		}
		case "I have met the Honorable Stellos. "
		{
			bark("What a wonderful man. I only hope to aspire to the knowledge he has gained during his long life. ");
			askList -= <<"I have met the Honorable Stellos. ">>;
		}
		case "bye "
		{
			bark("Be well, my friend. ");
			exitConvo();
			return;
		}
		case "I have found your Focus of healing! "
		{
			if class_0581_take(1, 396, 9, 1, 1)
			{
				bark("How wonderful! Thank you, my friend. There is no way I can repay this debt, but should you need healing, please come to me. ");
				hasXavierFoci = 0;
				fociReturned = 1;
			}
			else
			{
				bark("What? You do not have my Focus! ");
				bark("Do not toy with me with matters like that! I must have my focus returned! ");
			}
			exitConvo();
			return;
		}
	}
	u8label label_7F95:
	u8goto label_2024;
	u8label label_7F98:
	bark("Goodbye! ");
	exitConvo();
	return;
}

