				bark("It is as I have said: many people fear us, and many more can not live so demanding and structured life as is necessary of one who serves the Mountain King. ");
				local_m06 += <<"Why do people fear you? ">>;
				local_m06 -= <<"Why were you the only apprentice? ">>;
			}
			case "Why do people fear you? "
			{
				bark("Many people are ignorant and do not understand what we do. They think that we live with corpses and that we are diseased. All of this is foolishness. ");
				local_m06 -= <<"Why do people fear you? ">>;
			}
			case "So that is the Ceremony of Eternity? "
			{
				bark("Yes, the ceremony must be performed as Lithos has commanded. You see, as Lothian was Necromancer, she will be permitted into the Hall of Eternity. In order to be allowed into this most hallowed of places, the Necromancers must be prepared in the Ceremony of Eternity. ");
				local_m06 += <<"What is the Hall of Eternity? ">>;
				local_m06 -= <<"So that is the Ceremony of Eternity? ">>;
			}
			case "I have seen the Birthplace of Moriens. "
			{
				bark("That is well. I hope that your experience was as wonderful as my own. ");
				local_m06 -= <<"I have seen the Birthplace of Moriens. ">>;
			}
			case "What is the Hall of Eternity? "
			{
				bark("The Hall of Eternity is a special place within the City of the Dead. The City of the Dead is a place where only Necromancers are allowed. It is there that Lithos sits upon His throne and consults His Necromancers, and dispenses His judgement. The Hall is a most prestigious place. ");
				local_m06 += <<"The City of the Dead? ">>;
				local_m06 -= <<"What is the Hall of Eternity? ">>;
			}
			case "The City of the Dead? "
			{
				bark("Yes, the heart of Lithos' realm. The City of the Dead is where all Necromancers who have been interred go and live on in death under Lithos' gentle rule. ");
				local_m06 -= <<"The City of the Dead? ">>;
			}
			case "You need an apprentice? "
			{
				bark("Yes, I do. While we are on this subject, it occurs to me that you are a man of exceptional qualities, both physical and spiritual. Would you wish to become my apprentice? ");
				local_m06 = <<"Yes, I am honored. ", "No, thank you. ">>;
			}
			case "Yes, I am honored. "
			{
				bark("Good, then it is so done. As my apprentice, I would have you begin your studies immediately. Much must be learned before one can wield the magic of a Necromancer. ");
				local_m06 += <<"What must I do? ", "I'll learn magic? ">>;
				local_m06 -= <<"Yes, I am honored. ", "No, thank you. ">>;
				askToDo = 1;
				isApprentice = 1;
			}
			case "What must I do? "
			{
				bark("First you must gather some reagents for me. Return them to me and I will teach you of their magical properties. There will be other tasks to follow. If you accomplish all of them correctly, then I shall make you my apprentice, and most likely, the Scion. After that, you shall make a pilgrimage. ");
				local_m06 += <<"What reagents do you need? ", "A pilgrimage? ">>;
				local_m06 -= <<"What must I do? ">>;
			}
			case "A pilgrimage? "
			{
				bark("Do not concern yourself with that now. There is much that must be done before you may even think about your holy pilgrimage. ");
				local_m06 -= <<"A pilgrimage? ">>;
			}
			case "No, thank you. "
			{
				bark("This saddens me. I do think that you would make a fine apprentice, and eventually, Necromancer. Is your mind completely made up, are you certain that you do not wish to be my apprentice? ");
				local_m06 = <<"Yes, I am certain. ", "Well, perhaps I should be your apprentice. ">>;
			}
			case "Yes, I am certain. "
			{
				bark("Very well, I am sure you have good reason for your decision. I am, however, very busy and must get on with my duties. Thank you very much for your help, but I must be on my way. ");
				local_m06 -= <<"Yes, I am certain. ">>;
				exitConvo();
				playMusic(121);
				return;
			}
			case "Well, perhaps I should be your apprentice. "
			{
				bark("Good, then it is done. As my apprentice, I would have you begin your studies immediately. Much must be learned before one can wield the magic of the Necromancer. ");
				local_m06 += <<"What must I do? ", "I'll learn magic? ">>;
				isApprentice = 1;
				local_m06 -= <<"Well, perhaps I should be your apprentice. ", "Yes, I am certain. ">>;
			}
			case "I'll learn magic? "
			{
				bark("Indeed you will, my apprentice. By the time that you have completed your studies, you will be capable of more than you ever dreamed possible. ");
				local_m06 += <<"There is much to learn. ">>;
				local_m06 -= <<"I'll learn magic? ">>;
			}
			case "There is much to learn. "
			{
				bark("Indeed there is, apprentice. That is why you must consult the library freely and often. There you will learn much of our order, our history, and our magic. ");
				local_m06 += <<"Where is the library? ", "Will you help me learn? ">>;
				local_m06 -= <<"There is much to learn. ">>;
			}
			case "Where is the library? "
			{
				bark("It is located just upstairs. Feel free to use it at any time. I expect to see you there quite often. ");
				local_m06 -= <<"Where is the library? ">>;
			}
			case "Will you help me learn? "
			{
				bark("Yes, of course, my student. It is part of my responsibility to teach you all that I know. ");
				local_m06 -= <<"Will you help me learn? ">>;
			}
			case "What reagents do you need? "
			{
				bark("I need for you to bring me a sample of Executioner's Hood from a place of danger and fallen sticks from a place where spirits roam. ");
				local_m06 += <<"These items are -magical-? ", "What does Executioner's Hood look like? ", "Where spirits roam? ">>;
				local_m06 -= <<"What reagents do you need? ">>;
				toldReagents = 1;
				if not devonInRule
				{
					benticCacked = 1;
					devonJailed = 1;
					Bentic.teleport(getX(), getY(), getZ(), 0);
					Bentic.setDead();
				}
			}
			case "Where spirits roam? "
			{
				bark("Yes, that is very important. Go to Western Tenebrae. There you will find the sticks, better known as `deadman's elbows,' that I need. ");
				local_m06 -= <<"Where spirits roam? ">>;
			}
			case "These items are -magical-? "
			{
				bark("Each taken individually, the item's magical properties are inert. However, when blended together under the proper conditions and intonements, their magical qualities are unlocked. All of this you will learn in time. ");
				local_m06 -= <<"These items are -magical-? ">>;
			}
			case "What does Executioner's Hood look like? "
			{
				bark("It is a black, leafy plant. It grows nearby, between the Graveyard and Tenebrae. Look for the hood under a large tree. It is a rare plant, so look closely. ");
				local_m06 -= <<"What does Executioner's Hood look like? ">>;
			}
			case "The same will happen to you? "
			{
				bark("Of course. When my time comes to be sent to meet the Mountain King, my first apprentice will perform the Ceremony of Eternity and prepare me for my journey. It is the way of the Necromancer. ");
				local_m06 -= <<"The same will happen to you? ">>;
			}
			case "I have brought you the reagents, Necromancer. "
			{
				bark("Give them to me. ");
				local_m02 = Avatar.getEquip(6);
				Avatar.turnToFace(1, 0, 15);
				turnToFace(3, 1, 15);
				foreach recursive local_m14 where (type = 395) within container local_m02 {
					if (local_m14.getFrame() = 10) or (local_m14.getFrame() = 20)
					{
						local_m14.destroy();
					}
				}
				bark("You have done well, my apprentice. For your efforts and your obvious learning, I have something for you. This is the Key of the Caretaker. It will allow you entry into the Upper Catacombs. There you must go to learn more of our art. ");
				local_m06 = <<"What is in the Catacombs? ", "Where are the upper catacombs? ", "What is the Key of the Caretaker? ", "Farewell. ">>;
				if class_0581_give(1, 232, 0, 0, 1)
				{
					haveReagentsDone = 1;
				}
				else
				{
					Item_create(0, 232, u8_local_address(local_m16_w01));
					local_m18 = Avatar.getEquip(6);
					local_m16.pop(local_m18);
					haveReagentsDone = 1;
				}
				local_m06 -= <<"I have brought you the reagents, Necromancer. ", "Hello, Necromancer. ">>;
			}
			case "What is the Key of the Caretaker? "
			{
				bark("The Key is an item of power which will allow you to cast the spells which you will learn in the Catacombs. In order to cast spells, you must place the proper reagents in a bag, close the bag, and then invoke the power of the key on the closed bag. When you open the bag, you will find a magic talisman within. When you invoke the magic of the talisman, you cast the spell. ");
				local_m06 -= <<"What is the Key of the Caretaker? ">>;
			}
			case "What is in the Catacombs? "
			{
				bark("There you will find the ancient Necromancers. Those who travelled the path of the Necromancer long before you or I. My  ancient ancestors will teach you what you need to know of our magic. ");
				local_m06 += <<"How am I to find them? ", "Can you not teach me magic? ">>;
				local_m06 -= <<"What is in the Catacombs? ">>;
			}
			case "How am I to find them? "
			{
				bark("With good faith and a strong heart. Do not worry, apprentice. The Ancient Necromancers will make themselves known to you. ");
				local_m06 -= <<"How am I to find them? ">>;
			}
			case "Can you not teach me magic? "
			{
				bark("I can, and in years to come I will. However, the first level of spells you must learn from the ancient Necromancers. Those who first created the spells that you will learn will teach them to you. If you pass their tests, you will learn their magic. Then you must come back to me. ");
				local_m06 -= <<"Can you not teach me magic? ">>;
			}
			case "Where are the upper catacombs? "
			{
				bark("You will find the entrance to the catacombs through the very rock itself. You will need the Open Earth spell, which you can find in the library, and the Key of the Caretaker. Go you then just north of here. There you will find a small hall. Cast the Open Earth spell upon the rock face and you shall gain entrance to the the catacombs. ");
				local_m06 += <<"The spell is in the library? ">>;
				local_m06 -= <<"Where are the upper catacombs? ">>;
			}
			case "The spell is in the library? "
			{
				bark("Yes, there you find much that will help you. For in order that you may speak to the Necromancers, there is another spell which you must learn. ");
				local_m06 += <<"What is there that will help me? ", "What other spell? ">>;
				local_m06 -= <<"The spell is in the library? ">>;
			}
			case "What other spell? "
			{
				bark("As the Necromancers are, to be certain, dead, you must cast Death Speak upon their sacred corpses. Only then shall you hear the voices of wisdom from their lifeless mouths. This spell you shall also find in the library. ");
				local_m06 -= <<"What other spell? ">>;
			}
			case "What is there that will help me? "
			{
				bark("In the library, there are books of knowledge. Not only spells that you must learn, but also the history of our Necromantic order. In the library you will also find many reagents which you may use when learning to cast spells. ");
				local_m06 -= <<"What is there that will help me? ">>;
			}
			case "I have met the Mountain King. "
			{
				bark("And since you are still alive, I can see that He and His Ancient Necromancers did approve of you. Now, I have something else for you, my apprentice. ");
				local_m06 = <<"The journey was difficult. ", "You have something for me? ">>;
			}
			case "The journey was difficult. "
			{
				bark("Yes, I remember when I met the Mountain King. I too found the journey most difficult. Yet, all has been worth the effort. ");
				local_m06 -= <<"The journey was difficult. ">>;
			}
			case "You have something for me? "
			{
				bark("Not yet, my apprentice. Did Lithos tell you that there is one last task for you to perform? ");
				local_m06 = <<"Yes, he did. ", "No, he didn't. ">>;
			}
			case "No, he didn't. "
			{
				bark("He did not? I do not believe you. The Mountain King instructed me to ask you if He had told you what you must do. He told me He instructed you to inter Lothian. If you did not perform this task, you were to be expelled from His order. Now you lie to me. Therefore, you must go from here. Never return here again. ");
				local_m06 -= <<"No, he didn't. ">>;
				vividosPissed = 1;
				exitConvo();
				playMusic(121);
				return;
			}
			case "Yes, he did. "
			{
				bark("What did He tell you? ");
				local_m06 = <<"I must inter Lothian. ">>;
			}
			case "I must inter Lothian. "
			{
				bark("That is correct, apprentice. Take this, the Key of the Scion. By touching this item to Lothian, you will make her body acceptable for interment, as commanded in our covenant with Lithos. Know that this Key will also permit access through many doors within the Catacombs. ");
				if class_0581_give(1, 232, 3, 0, 1)
				{
					Item_bark(u8_string_address("Thank you, Necromancer. "), u8_stack_ref(1));
					gotTheKey = 1;
				}
				else
				{
					Item_bark(u8_string_address("You did not give me a key, Necromancer. "), u8_stack_ref(1));
				}
				local_m06 = <<"Another key? ", "Where is Lothian? ">>;
			}
			case "Where is Lothian? "
			{
				bark("You will find her outside of the tomb, near the Northeast corner of the building. There her body awaits you to send it to the Mountain King. ");
				local_m06 -= <<"Where is Lothian? ">>;
			}
			case "Another key? "
			{
				bark("Yes, but as you have seen, these keys are not what one normally thinks of as a key. This is not so much a physical key as it is a spiritual one. ");
				local_m06 -= <<"Another key? ">>;
			}
			case "Farewell. "
			{
				if isApprentice
				{
					bark("Farewell, apprentice. ");
				}
				else
				{
					bark("Farewell, my friend. ");
				}
				local_m06 -= <<"Farewell. ">>;
				exitConvo();
				playMusic(121);
				return;
			}
			case "I have interred Lothian, Necromancer. "
			{
				bark("You have done well, my apprentice. You have shown yourself well. You have served with bravery and great knowledge. I have decided to name you Scion and thereby officially name you my heir in the Necromatic line. Now, you are ready to make your pilgrimage. ");
				local_m06 = <<"Thank you, Necromancer. ", "Oh yes, my pilgrimage. ">>;
				local_m06 -= <<"I have interred Lothian, Necromancer. ">>;
			}
			case "Hello, Necromancer. "
			{
				bark("Greetings to you, my apprentice. I trust that all is well? ");
				local_m06 += <<"Yes, I am well. ", "No, things are not well. ">>;
				local_m06 -= <<"Hello, Necromancer. ">>;
			}
			case "Yes, I am well. "
			{
				bark("Good, good. Lithos does provide well for His followers. ");
				local_m06 -= <<"Yes, I am well. ", "No, things are not well. ">>;
			}
			case "No, things are not well. "
			{
				bark("Well, trust in Lithos and everything will work out. ");
				local_m06 -= <<"Yes, I am well. ", "No, things are not well. ">>;
			}
			case "Oh yes, my pilgrimage. "
			{
				bark("Yes, your pilgrimage. It is customary for the Scion to make a pilgrimage to the birthplace of Moriens. There, the Scion does pay homage to Moriens and hope for a visitation. ");
				saidBirth = 1;
				local_m06 += <<"Where is this place? ", "A visitation? ">>;
				local_m06 -= <<"Oh yes, my pilgrimage. ">>;
			}
			case "A visitation? "
			{
				bark("Yes, well do I remember my pilgrimage. Long did I travel, and such an adventure it was. And when I arrived at the holy birthplace, I did see a most magnificent thing. It was so wonderous that first I thought myself to be mad. ");
				local_m06 += <<"Was it dangerous? ", "What did you see? ">>;
				local_m06 -= <<"A visitation? ">>;
			}
			case "What did you see? "
			{
				bark("Perhaps it is best that I do not tell you. I would not wish to color your expectations. After all, everyone comes away from their pilgrimage with a different experience. But be certain that your experience shall be a profound one. ");
				local_m06 -= <<"What did you see? ">>;
			}
			case "Was it dangerous? "
			{
				bark("What kind of a question is that from a man who has already performed such great deeds? ");
				local_m06 -= <<"Was it dangerous? ">>;
			}
			case "Where is this place? "
			{
				bark("You must return to the Upper Catacombs. Once there, seek out the signs that mark the way. ");
				local_m06 -= <<"Where is this place? ">>;
			}
			case "Thank you, Necromancer. "
			{
				bark("Say no more, Scion. You have earned your status. ");
				local_m06 -= <<"Thank you, Necromancer. ">>;
			}
			default
			{
				bark("Did you wish to continue this conversation? ");
			}
		}
	}
}

