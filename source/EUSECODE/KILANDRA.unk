			{
				bark("YE! I thought I told ye to leave! Now I advise ye do it, and do it quick. A'fore I cuts ye into fish bait. ");
				exitConvo();
				return;
			}
			else
			{
				bark("Ah, so ye's returned. What can I do for you? ");
				askList -= <<"Hello, Kilandra. ">>;
				askList = <<"Tell me about your daughter. ", "Tell me of the Sea of Rains. ">>;
				if hydrosFree
				{
					askList += <<"The weather is certainly bad. ">>;
				}
			}
		}
		case "The weather is certainly bad. "
		{
			bark("Ye'r telling me! Why I haven't seen rain like this in all my days. I haven't been able to put out to sea since it started. Why, even the fish didn't expect this, or I'm sure they'd have said something to me about it. That Tempest is certainly got a lot of explainin' to do! ");
			askList -= <<"The weather is certainly bad. ">>;
			askList = <<"The fish tell you of weather? ", "I caused this weather. ">>;
			if devonInRule
			{
				askList += <<"It is not Devon's fault. ">>;
			}
		}
		case "I caused this weather. "
		{
			bark("Ye? Hmmm. No, I don't think I believe ye. Only the Tempest can effect the weather. I don't believe you are the Tempest. ");
			askList += <<"I released Hydros. ">>;
			askList -= <<"I caused this weather. ">>;
		}
		case "I released Hydros. "
		{
			bark("Ye say ye released Hydros, do ye? Well, sure ye did, now lad, sure ye did. And this caused the rains, then? Well, what else have ye done? Been to the Pit of Death? Seen the Shrine of the Ancients? Har, har, har. Oh lad, Ye need to get away, some place calm and quiet, maybe take up fishing. This traveling life has really been a little hard on ye, hasn't it? ");
			askList -= <<"I released Hydros. ">>;
		}
		case "It is not Devon's fault. "
		{
			bark("Devon? Is that lad the Tempest then? Oh my. He is a good lad. The fish knew there was something about him. Whispered his name often, they did. ");
			askList -= <<"It is not Devon's fault. ">>;
		}
		case "The fish tell you of weather? "
		{
			bark("Of course. They tell me lots of things. In fact, ye ought to take the time out to talk to them yer'self! ");
			askList -= <<"The fish tell you of weather? ">>;
		}
		case "Tell me about your daughter. "
		{
			bark("That's something I'ds rather not speak of. The pain is very fresh. ");
			askList -= <<"Tell me about your daughter. ">>;
		}
		case "Kilandra? "
		{
			bark("What? Are ye deaf? I want no part of ye! Get out of my sight! ");
			exitConvo();
			return;
		}
		case "Pardon me. "
		{
			bark("I saw her. Oh by the Titans, I saw her! She was wet and covered with slime, and the fish had eaten half of her beautiful face. Oh, how can I bear it? I ask you, how?! ");
			exitConvo();
			return;
		}
		case "bye "
		{
			bark("Farewell. ");
			exitConvo();
			return;
		}
	}
	u8goto label_0DDE;
	u8label label_4007:
	exitConvo();
}

