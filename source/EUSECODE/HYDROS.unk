process [[PT_DEFAULT, referent]] HYDROS::hydros_announce_escape()
{
	bark("Ah, I am now free! Thank you, foolish one, for your actions. Consider my gift of your wretched life as payment for your part. Now I will have my vengeance upon your pathetic kind! I will slay the descendant of my jailer! Let us see who can reach Devon first, groundling. ");
	hydrosFree = 2;
	scrollBack(20);
	setAvatarInStasis(0);
	// X: reconstructed continuation; an explicit dependency sequence is equivalent.
	spawn class_0050_hydros_animate_departure_cleanup(this) -> return;
	return;
}

