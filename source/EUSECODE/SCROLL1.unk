	// X: `this` binds the compiler-carried current-object receiver.
	this:U8DWord;
	Scroll_read(u8_string_address("Lieutenant Vittek-~ See that you meet me at the Docks as soon as you can. I have a solution to the missing Skull of Quakes dilemma.~ -Mordea"), this);
