					bark("Well, it's simple enough. They are only the most powerful beings in all of Pagan. Were they not bound by or in contract with the people, as in times before, they would be gods to us. ");
				}
				else if local_m0A = 0
				{
					bark("It is good that you do know, for I did not think that one could come from so far as to be ignorant of the Titans. ");
				}
				else
				{
					local_m04 = "";
				}
				local_m06 -= <<"What is a Titan? ">>;
				local_m14 = 1;
			}
			case "What do you know of the Titans? "
			{
				bark("I know the names and titles by which the people adress them, and the Elements they have reign over. Other than this I cannot... or will not tell you... at least, not yet. ");
				local_m06 -= <<"What do you know of the Titans? ">>;
			}
			case "What is the Cabal? "
			{
				bark("The Cabal is simply the term we Sorcerers use to mean our kind, collectively. It is made up of one Master, one First Acolyte, three other Acolytes, and various other Disciples. ");
				local_m06 = <<"Farewell. ">>;
				if not local_m16
				{
					local_m06 ^= <<"Tell me of your Master. ">>;
				}
				if not local_m17
				{
					local_m06 ^= <<"What do you mean by First Acolyte? ">>;
				}
				if not local_m11
				{
					local_m06 ^= <<"What is an Acolyte? ">>;
				}
				local_m06 ^= <<"What is a Disciple? ">>;
				local_m15 = 1;
			}
			case "Who are the Acolytes? "
			{
				bark("The Acolytes are poorly led by the First Acolyte who is more beast than man. His name is Vardion, and you would do well to avoid him, as his odor can be most offensive. ");
				bark("I, of course, am also one of the Acolytes, then there is Gorgrond. Sometimes a bit slow of wit, and easily led astray by those that he thinks are of greater importance. ");
				bark("Lastly, there is Beren. A man to be trusted. He is as good as his word, and his word is beyond reproach. You could do worse than to take his advice in all things. ");
				local_m06 = <<"Farewell. ">>;
				if not local_m17
				{
					local_m06 ^= <<"What do you mean by First Acolyte? ">>;
				}
				local_m06 ^= <<"Tell me more of Vardion. ", "Do you know more about Gorgrond? ", "What else can you say of Beren. ">>;
				local_m12 = 1;
			}
			case "Tell me of your Master. "
			{
				bark("Malchir is a wily one, but his self-interest is counter to my own outgoing nature. He should become more concerned with the other Sorcerers instead of always hiding himself away. ");
				bark("Nonetheless, he makes a fine and powerful Master otherwise. Other Acolytes malicious comments are unwarranted and you should take no heed of them. ");
				local_m06 -= <<"Tell me of your Master. ">>;
				local_m06 ^= <<"Malicious comments? ">>;
				local_m16 = 1;
			}
			case "Tell me more of Corodin. "
			{
				bark("Truly, I know little else of the man. He died ages ago and before that he did little to recommend him to memory. ");
				local_m06 -= <<"Tell me more of Corodin. ">>;
			}
			case "Do you know more about Maedron? "
			{
				bark("He was a great Sorcerer, quite possibly the greatest. It was his insight that brought about the magical formulae we use in our Sorcery. ");
				bark("He created the Elder Tongue to aid in the manipulation of Fire and our modern spellcraft. In truth, I wish I could have been one of his contemporaries, for there is no telling what great mysteries were lost upon his death. ");
				local_m06 = <<"Farewell. ">>;
				if not local_m0E
				{
					local_m06 ^= <<"What is Sorcery? ">>;
				}
				if not local_m0C
				{
					local_m06 ^= <<"Tell me of the Elder Tongue. ">>;
				}
				if not local_m10
				{
					local_m06 ^= <<"What do you mean by Fire? ">>;
				}
			}
			case "The Calling? "
			{
				bark("The Calling is a challenge from one Sorcerer to another, and invariably ends in the death of one of the participants. No other form of arbitration is allowed, save as the Master deems fitting. It is the way by which we keep peace amongst ourselves. ");
				bark("The rules of issuing a Call are as follows: No Sorcerer may Call upon another without the permission of the Master, except when the Master Calls or is Called. Only an Acolyte may Call upon the Master. ");
				bark("A Sorcerer who breaks these simple rules can usually number his remaining days upon one hand. ");
				local_m06 -= <<"The Calling? ">>;
				local_m18 = 1;
			}
			case "What do you mean by First Acolyte? "
			{
				bark("The First Acolyte is chosen to be the Master's second in command, and tends to the daily affairs of running the Enclave. ");
				bark("The Master needs someone who understands people. Someone with a vision for the future. ");
				if not baneOffer
				{
					local_m02 = "Vardion,";
					if not local_m12
					{
						local_m02 += " our current First Acolyte, ";
					}
					local_m02 += " is not this someone. Far to the contrary. He lingers in the past. ";
					bark(u8_string_local_address(local_m02));
					bark("Observing out-dated traditions for tradition's sake... but I digress.*Perhaps you grow bored with this line of conversation? ");
					local_m06 -= <<"What do you mean by First Acolyte? ">>;
					if not local_m19
					{
						local_m06 ^= <<"Tell me more of Vardion. ">>;
					}
					local_m08 = local_m06;
					local_m06 = <<"No, please go on. ", "Can we change the subject? ", "Yes, I'm sorry, I have. ", "Not bored, just disinterested. ", "Farewell. ">>;
					baneOffer = 1;
				}
				else if not baneJoined
				{
					bark("Are you still wary of discussing this further? ");
					local_m06 -= <<"What do you mean by First Acolyte? ">>;
					local_m08 = local_m06;
					local_m06 = <<"No, please go on. ", "Can we change the subject? ", "Farewell. ">>;
				}
				else
				{
					bark("Perhaps you are this someone. ");
					local_m06 -= <<"What do you mean by First Acolyte? ">>;
				}
				local_m17 = 1;
			}
			case "What is a Disciple? "
			{
				bark("A Disciple is a Sorcerer, and therefore a full member of the Cabal, but they have not been inducted into the select group called Acolytes. ");
				bark("Not to champion my own meager abilities, but only the most powerful and... or skilled Disciples are allowed to join into our ranks. ");
				local_m06 -= <<"What is a Disciple? ">>;
			}
			case "Tell me more of Vardion. "
			{
				bark("Not to put too fine a point on it, he is a brutish, overbearing, pompous lout. In other words, I find his presence intolerable and if Master Malchir were not so engrossed in his own affairs, I feel sure that he would allow me to issue The Calling to Vardion, even if he is the First Acolyte. ");
				local_m06 = <<"Farewell. ">>;
				if not local_m16
				{
					local_m06 ^= <<"Tell me of your Master. ">>;
				}
				if not local_m18
				{
					local_m06 ^= <<"The Calling? ">>;
				}
				if not local_m17
				{
					local_m06 ^= <<"What do you mean by First Acolyte? ">>;
				}
			}
			case "Do you know more about Gorgrond? "
			{
				bark("He is as simple-minded as he is magically powerful... in a raw, and unskilled fashion. He is the perfect tool, which is why, I believe, he was made an Acolyte. Certainly, he is useful to those in a position to manipulate him. ");
				local_m06 -= <<"Do you know more about Gorgrond? ">>;
			}
			case "What else can you say of Beren. "
			{
				bark("Naught but good. His mind is quick, his body a finely crafted work, his magical skill and power are only slightly beneath my own. Taken altogether, quite a remarkable fellow. I would trust him with my life, were I you. ");
				local_m06 -= <<"What else can you say of Beren. ">>;
			}
			case "Malicious comments? "
			{
				bark("It would only perpetuate these comments to give them voice, therefore I shall refrain. ");
				local_m06 -= <<"Malicious comments? ">>;
			}
			case "No, please go on. "
			{
				bark("I will entrust to you further knowledge of our predicament. I have reason to believe that Vardion is preparing to assassinate the Master. ");
				bark("He thinks that Malchir breaks with too many of the old traditions but fears his power. Should he kill Malchir and become Master, he will return the Enclave to the days when Sorcerers were shunned by the rest of the island's populace. ");
				bark("To get to the point at hand, I must ask a favor of you. I need someone to enter into the confidences of the First Acolyte and acquire from him his Truename. This will aid me in performing a scrying to know Vardion's motives. ");
				bark("Will you do this?*If so, I can offer you a position as a Disciple... or even Acolyte, should Vardion's intentions be murderous. ");
				local_m06 = <<"I agree to your terms. ", "What else can you offer? ", "I will not be your spy, lady. ", "I do not trust -your- motives. ", "Let me think on it. ">>;
				baneHasAsked = 1;
			}
			case "Can we change the subject? "
			{
				bark("Of course. I am truly sorry to embroil you in the affairs of what must be, to you, a strange people indeed. Please forgive my temporary indiscretion. ");
				local_m06 = local_m08;
			}
			case "Yes, I'm sorry, I have. "
			{
				bark("Please... let me bore you no further. ");
				baneMad = 1;
			}
			case "Not bored, just disinterested. "
			{
				bark("As your interest wanes, so does my civility. Please go before I say something you might regret. ");
				baneMad = 1;
			}
			case "I agree to your terms. "
			{
				bark("Good. You are perceptive and wise, my Daemion. Firstly, in order to become a Disciple Sorcerer, you must have an Acolyte for a sponsor. I shall be that for you. Secondly, as your sponsor, I will give you a Truename... ");
				bark("Daemion you are to me, and Daemion you shall be to the Fire. My inner sight judged your name correctly it would seem. I have always had that ability. To lend power to your Truename, I must reveal mine to you. Sabriane it is, and it means Well of Stars. ");
				bark("Now your first task as my Disciple is to enter into the confidences of our illustrious First Acolyte and get from him his Truename. I care not how you do this, just get it. ");
				baneJoined = 1;
				local_m04 = "Farewell. ";
			}
			case "What else can you offer? "
			{
				bark("I have made a far greater offer than you apparently are capable of understanding. To become a Sorcerer is to become one with power. Take that as you will, as you take leave of these premises. ");
				baneMad = 1;
			}
			case "I will not be your spy, lady. "
			{
				bark("That is your choice, my ignorant friend. My offer still stands, but perhaps you are not the one I should give it to. ");
				baneMad = 1;
			}
			case "I do not trust -your- motives. "
			{
				bark("It is not my motives that should be in question. You are the stranger here. And if I wished it, I could have you thrown out! ");
				baneMad = 1;
			}
			case "Let me think on it. "
			{
				bark("I apologize for placing this pressure on you, but it is of dire consequence. I will await your answer. ");
				local_m04 = "Farewell. ";
			}
			case "Farewell. "
			{
				class_0595_bane2_say_farewell(this);
			}
			case ""
			{
				class_0595_bane2_handle_silent_avatar(this);
				local_m04 = "Farewell. ";
			}
			default
			{
				bark("I can't understand you. What did you say? ");
			}
		}
		if baneMad
		{
			local_m04 = "Farewell. ";
		}
	}
}

