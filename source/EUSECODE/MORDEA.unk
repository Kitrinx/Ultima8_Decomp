// Derived: routine 0x1A50, event mask 0x00000000.
// O: recovered callable name.
// O: external source-declaration metadata proves this callable kind.
process Mordea::onThrone()
{
	// X: BP-bound body storage views; current-object receiver is implicit.
	chair:Item;
	pathEgg:Item;
	counter:Number;
	dir:Number;
	ran:Number;
