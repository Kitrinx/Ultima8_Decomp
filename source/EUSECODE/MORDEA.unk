		{
			ran = urandom(10);
			if ran < 5
			{
				bark("Greeting's again. ");
			}
			else
			{
				bark("How can I help you, " + getName() + "?");
			}
		}
		askList ^= <<"May I speak with you? ", "bye ">>;
	}
	name = "I am " + getName() + ".";
	while answer != "bye "
	{
		askList -= <<"bye ">>;
		askList += <<"bye ">>;
		answer = ask(askList);
		// X: reconstructed repeated-string selection; authored switch versus if ladder is unproved.
		switch answer
		{
			case "Yes, I am. "
			{
				mordeaJob = 1;
				bark("Who are you that you dare address the Tempest? ");
				askList -= <<"Yes, I am. ">>;
				askList = <<name, "That is not your concern. ", "May I speak with you? ", "Who are you? ", "Tempest? ", "Tell me of the Tempestry. ">>;
			}
			case name
			{
				bark("I know not your name nor your face. I think you are not from Tenebrae. Where are you from? ");
				askList = <<"I am from Britannia. ", "I am from Earth. ", "I am from far away. ", "I am from Tenebrae. ">>;
			}
			case "I am from Tenebrae. "
			{
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn class_0407_throwArms(this) -> return;
				bark("You are a liar. I know all my subjects...and they know me. I will not tolerate such impudence. ");
