			case "Tempest? ", "Tell me of the Tempestry. "
			{
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn class_0407_throwArms(this) -> return;
				bark("Know you not of the Tempestry and its great power? Perhaps, then you should like a taste of it. -When I feed you to the Lurker!- ");
				exitConvo();
				return;
			}
			case "May I speak with you? "
			{
				bark("I am not familiar with your name or your face. I think you are not from Tenebrae. Where are you from? ");
				mordeaPissed = 0;
				askList -= <<"By what are you called? ">>;
				askList = <<"I am from Britannia. ", "I am from far away. ", "I am from Earth. ", "I am from Tenebrae. ">>;
			}
			case "I am from Britannia. "
			{
				// X: reconstructed continuation; an explicit dependency sequence is equivalent.
				spawn class_0407_throwArms(this) -> return;
				bark("I've never heard of such a place. You are either a liar or a fool. You don't look smart enough to be a liar and I will not tolerate a fool. ");
