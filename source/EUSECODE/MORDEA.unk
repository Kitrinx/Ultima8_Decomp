	if getMap() = 3
	{
		if not devonJailed
		{
			bark("Imbecile! Do you wish to join Toran? Get out of my way! ");
			exitConvo();
			return;
		}
	}
	if not mordeaMet
	{
		Item_bark(u8_string_address("Greetings! "), u8_stack_ref(1));
	}
	else
	{
		Item_bark(u8_string_address("Greetings, your Ladyship! "), u8_stack_ref(1));
	}
